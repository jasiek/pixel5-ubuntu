# SPDX-License-Identifier: MIT
# USB link to the Mac. "shared" = NetworkManager runs a DHCP server here,
# so the Mac gets 172.16.42.x automatically. Phone is 172.16.42.1.
[connection]
id=usb0
type=ethernet
interface-name=usb0
autoconnect=true

[ipv4]
method=shared
address1=172.16.42.1/24

[ipv6]
method=link-local
