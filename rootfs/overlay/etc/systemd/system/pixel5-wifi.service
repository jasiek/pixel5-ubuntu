# Wifi bring-up (P4.2): IPA firmware, wlan.ko, modem, then the board file.
# NetworkManager takes wlan0 from there. See pixel5-wifi-up for the crash
# guard (a boot that dies during bring-up disables wifi on the next ones).
[Unit]
Description=Bring up WLAN (modem, IPA, wlan.ko, board data)
# Wants, not Requires: the daemons restart themselves (they can start before
# qrtr-ns listens, Test 22), and a Requires= dependent is stopped with them.
Requires=pixel5-firmware.service
Wants=qrtr-ns.service pd-mapper.service tqftpserv.service rmtfs.service
After=pixel5-firmware.service qrtr-ns.service pd-mapper.service tqftpserv.service rmtfs.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
ExecStart=/usr/local/sbin/pixel5-wifi-up

[Install]
WantedBy=multi-user.target
