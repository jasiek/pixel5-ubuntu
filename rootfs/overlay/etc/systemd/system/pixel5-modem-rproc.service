# SPDX-License-Identifier: MIT
# Mainline kernel: start the modem remoteproc (qcom_q6v5_pas, auto_boot
# off). It also runs the WLAN firmware (wlan_pd): ath10k_snoc brings up
# wlan0 once the modem is up. pixel5-modem.service does this on the
# downstream kernel.
[Unit]
Description=Start the modem (mainline remoteproc)
ConditionKernelVersion=>=6
Wants=rmtfs.service tqftpserv.service pd-mapper.service
After=rmtfs.service tqftpserv.service pd-mapper.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The modem asks for its files and services right away: wait until rmtfs (14),
# pd-mapper (64) and tqftpserv (4096) are registered with the name service.
ExecStartPre=/usr/local/sbin/pixel5-qrtr-wait 14 64 4096
ExecStart=/usr/local/sbin/pixel5-rproc modem start
ExecStop=/usr/local/sbin/pixel5-rproc modem stop

[Install]
WantedBy=multi-user.target
