#!/bin/sh
# SPDX-License-Identifier: MIT
# Wait until the given QRTR services are registered with the name service.
#   pixel5-qrtr-wait <service> ...      (gives up after 60 s)
for i in $(seq 1 60); do
    have=$(timeout 3 qrtr-lookup 2>/dev/null | awk 'NR > 1 {print $1}')
    missing=""
    for s in "$@"; do
        echo "$have" | grep -qx "$s" || missing="$missing $s"
    done
    [ -z "$missing" ] && { echo "QRTR services up: $*"; exit 0; }
    sleep 1
done
echo "QRTR services still missing after 60 s:$missing" >&2
exit 1
