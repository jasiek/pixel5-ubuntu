#!/bin/sh
# SPDX-License-Identifier: MIT
# Headless "alive" signal (P5.5, owner's choice: vibration at boot).
#   2 short buzzes: booted, wlan0 connected (SSH over wifi works)
#   1 long buzz:    booted, but no wifi after 90 s (use USB: 172.16.42.1)
#   pixel5-alive buzz <ms>    one pulse, for testing
# The DRV2624 (drv2624.ko) is an LED-class device in real-time mode:
# brightness 1 starts the motor, 0 stops it.
V=/sys/class/leds/vibrator/brightness
buzz() { echo 1 > "$V"; sleep "$1"; echo 0 > "$V"; }
if [ "${1:-}" = buzz ]; then buzz "$(echo "${2:-200}" | awk '{print $1/1000}')"; exit; fi
for i in $(seq 1 90); do [ -w "$V" ] && break; sleep 1; done
[ -w "$V" ] || { echo "no vibrator device"; exit 0; }
for i in $(seq 1 90); do
    if nmcli -t -f DEVICE,STATE dev 2>/dev/null | grep -qx "wlan0:connected"; then
        echo "wifi connected after ~${i} s: 2 short buzzes"
        buzz 0.15; sleep 0.25; buzz 0.15
        exit 0
    fi
    sleep 1
done
echo "no wifi after 90 s: 1 long buzz"
buzz 1
