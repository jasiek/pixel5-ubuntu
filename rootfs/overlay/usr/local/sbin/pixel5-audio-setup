#!/bin/sh
# SPDX-License-Identifier: MIT
# Mixer defaults for the Pixel 5 sound card on mainline (P6.4):
#  - MultiMedia1 (hw:G5,0) -> quinary TDM -> both CS35L41 speaker amps
#  - microphones (RT5514P DSP over primary TDM) -> MultiMedia2 (hw:G5,1);
#    the DSP firmware (vendor rt5514p_dsp_fw1..4.bin) is loaded over SPI.
#    For the amps' current sense instead (tests):
#      amixer -c G5 cset name="MultiMedia2 Mixer PRIMARY_TDM_TX_0" 0
#      amixer -c G5 cset name="MultiMedia2 Mixer QUIN_TDM_TX_0" 1
# The amps run with their protection DSP bypassed (PCM Source ASP), so the
# digital volume starts at -20 dB (657; 817 = 0 dB). No mixer UI yet.
set -u
i=0
until grep -q "Google Pixel 5" /proc/asound/cards 2>/dev/null; do
	i=$((i + 1))
	[ "$i" -ge 60 ] && { echo "no Pixel 5 sound card"; exit 0; }
	sleep 1
done
set_() { amixer -q -c G5 cset name="$1" "$2" || echo "failed: $1 = $2"; }
for s in L R; do
	set_ "$s PCM Source" ASP
	set_ "$s Digital PCM Volume" 657
	set_ "$s ASP TX1 Source" IMON
	set_ "$s ASP TX2 Source" Zero
done
set_ "QUIN_TDM_RX_0 Audio Mixer MultiMedia1" 1
echo "speakers routed, volume -20 dB"

i=0
until [ -e /run/pixel5-fw/rt5514p_dsp_fw4.bin ]; do
	i=$((i + 1))
	[ "$i" -ge 60 ] && { echo "no RT5514P DSP firmware"; exit 0; }
	sleep 1
done
# the driver resets and retries a failed load itself; retry once more here
amixer -q -c G5 cset name="DSP I2S Capture Switch" on 2>/dev/null ||
	{ sleep 5; set_ "DSP I2S Capture Switch" on; }
set_ "Stereo1 DMIC Mux" DMIC1
set_ "Sto1 ADC MIXL DMIC Switch" on
set_ "Sto1 ADC MIXR DMIC Switch" on
set_ "MultiMedia2 Mixer PRIMARY_TDM_TX_0" 1
echo "microphones routed"
