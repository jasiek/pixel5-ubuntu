#!/bin/busybox sh
# SPDX-License-Identifier: MIT
# Pixel 5 (redfin) initramfs: find the userdata partition (= Ubuntu root),
# then switch_root into systemd.
#
# Debugging over USB (works even if Ubuntu never starts):
#   - USB network: NCM, phone 172.16.42.1, DHCP for the host, telnet on port 23
#   - USB serial:  ACM, getty with a root shell on /dev/ttyGS0
# Add "initdebug" to the kernel cmdline to stop here on purpose.
# Messages go to /dev/kmsg, so they also land in dmesg / pstore.

/bin/busybox --install -s /bin
export PATH=/bin

mkdir -p /proc /sys /dev /tmp /run /newroot
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
# Google's stock 4.19 kernel has no DEVTMPFS (Android's ueventd makes the
# nodes); fall back to a tmpfs /dev filled by busybox mdev. No hotplug
# helper either (STATIC_USERMODEHELPER), so devnodes() rescans on demand.
MDEV=""
if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
    mount -t tmpfs -o mode=0755 tmpfs /dev
    MDEV=1
fi
devnodes() { [ -z "$MDEV" ] || mdev -s; }
devnodes
mkdir -p /dev/pts
mount -t devpts   devpts   /dev/pts
mount -t configfs configfs /sys/kernel/config
mount -t tmpfs    tmpfs    /tmp

log() { echo "initramfs: $*" > /dev/kmsg; echo "initramfs: $*" >> /tmp/init.log; }
log "started, kernel $(uname -r)"

# Bring-up probes (no UART on redfin; a hang shows nothing):
#  - initstage=N: reboot to fastboot right after stage N, so "phone came back
#    to fastboot" proves we got that far. 0 = init runs (/dev ready),
#    2 = modules loaded, 3 = USB gadget bound.
#  - initdebug: the fastboot-return timer starts here, before anything that
#    can hang (Test 1: an image that hung before the old timer never came back).
# Firmware: the stock kernel has FW_LOADER_USER_HELPER_FALLBACK=y, so every
# firmware file missing on disk waits 60 s for a userspace helper (Android's
# ueventd) that we don't run, blocking insmod (Test 7). Fail fast instead.
echo 1 > /proc/sys/kernel/firmware_config/ignore_sysfs_fallback 2>/dev/null
echo 1 > /sys/class/firmware/timeout 2>/dev/null

# ---- module loader (modprobe-like) ---------------------------------------
# Android's first-stage init uses libmodprobe: soft "pre:" dependencies
# (modules.softdep), then hard ones (modules.dep), then the module. A plain
# modules.load walk loaded qti_qmi_sensor (#155) before qrtr (#217) although
# "softdep qmi_helpers pre: qrtr" says otherwise, and that stalled boot
# (Tests 7-9). Module names treat "-" and "_" alike. Missing files are fine:
# our own kernel may build things in.
M=/lib/modules
mkdir -p /tmp/mods.done
: > /tmp/mods.failed
tr - _ < $M/modules.softdep > /tmp/mods.softdep 2>/dev/null
for f in $M/*.ko; do f=${f##*/}; echo "$(echo "${f%.ko}" | tr - _) $f"; done > /tmp/mods.map
load_one() {   # $1 = module name or file name (recursive: keep vars local)
    local n f p d rev
    n=$(echo "${1%.ko}" | tr - _)
    [ -e /tmp/mods.done/$n ] && return 0
    touch /tmp/mods.done/$n               # mark first: no loops on cycles
    f=$(sed -n "s/^$n //p" /tmp/mods.map)
    [ -n "$f" ] || return 0               # not a module here
    for p in $(sed -n "s/^softdep $n pre: //p" /tmp/mods.softdep); do load_one "$p"; done
    rev=""
    for d in $(sed -n "s|^$M/$f:||p" $M/modules.dep); do rev="${d##*/} $rev"; done
    for d in $rev; do load_one "$d"; done
    insmod "$M/$f" 2>/dev/null || echo "$f" >> /tmp/mods.failed
}

# ---- early modules: watchdog + restart driver -----------------------------
# The bootloader leaves the Qualcomm hardware watchdog running; Android loads
# watchdog_v2.ko within 0.5 s to feed it. Without it the phone cold-resets
# after ~100 s (Tests 2b-4: boot reason "watchdog"). msm-poweroff.ko is meant
# to make `reboot bootloader` land in fastboot (it writes the restart reason).
for m in watchdog_v2 spmi-pmic-arb qcom-spmi-pmic qpnp-power-on msm-poweroff; do
    load_one "$m"
done
log "early modules: $(grep -c -E '^(watchdog_v2|msm_poweroff|qpnp_power_on) ' /proc/modules) of 3 key ones loaded"

stage() {
    if grep -qw "initstage=$1" /proc/cmdline; then
        # initstage_delay=S: wait S seconds first, so the return time shifts
        # by S if (and only if) our init is what rebooted (Test 3).
        d=$(sed -n 's/.*initstage_delay=\([0-9]*\).*/\1/p' /proc/cmdline)
        log "stage $1 reached, rebooting to bootloader in ${d:-0} s"
        sleep "${d:-0}"; sync; reboot-bootloader; sleep 30
    fi
}
if grep -qw initdebug /proc/cmdline; then
    t=$(sed -n 's/.*initdebug_timeout=\([0-9]*\).*/\1/p' /proc/cmdline)
    ( sleep "${t:-600}"; [ -e /tmp/keep ] || { log "debug timeout, rebooting to bootloader"; reboot-bootloader; } ) &
fi
stage 0

# ---- kernel modules -------------------------------------------------------
# On redfin UFS, USB, clocks and pinctrl are modules. With the stock kernel
# they come from the flashed vendor_boot's ramdisk (/lib/modules, merged
# with ours by the bootloader); our own kernels ship theirs in the same place.
# modules.load gives the order; load_one() pulls in dependencies first.
load_modules() {
    [ -f $M/modules.load ] || { log "no $M/modules.load"; return 0; }
    # initmods=N (bisecting a stall): load only the first N modules.
    n=$(sed -n 's/.*initmods=\([0-9]*\).*/\1/p' /proc/cmdline)
    head -n "${n:-100000}" $M/modules.load > /tmp/mods.list
    while read -r m; do load_one "${m##*/}"; done < /tmp/mods.list
    devnodes
    log "modules: $(wc -l < /tmp/mods.list) listed, $(wc -l < /tmp/mods.failed) failed (/tmp/mods.failed)"
}
load_modules
stage 2

# ---- USB gadget: NCM network + ACM serial ---------------------------------
G=/sys/kernel/config/usb_gadget/g1
setup_usb() {
    mkdir -p $G/strings/0x409 $G/functions/ncm.usb0 $G/functions/acm.GS0 \
             $G/configs/c.1/strings/0x409
    # Fixed, locally administered MACs. Random ones (the default) look like a
    # new network interface to macOS on every boot, and after the first
    # (en12) it stopped naming them: enumerated, NCM driver attached, no enX,
    # no ping (Test 13). In 4.19 the NCM net device exists from mkdir
    # (ncm_alloc_inst -> gether_setup_default), so writing before bind is
    # safe here (it panicked the Pixel 2's 4.4, where it only exists after bind).
    echo 02:50:35:00:00:02 > $G/functions/ncm.usb0/dev_addr
    echo 02:50:35:00:00:01 > $G/functions/ncm.usb0/host_addr
    echo 0x18d1 > $G/idVendor
    echo 0xd001 > $G/idProduct
    echo "Google"           > $G/strings/0x409/manufacturer
    echo "Pixel 5 (Ubuntu)" > $G/strings/0x409/product
    echo "pixel5-ubuntu"    > $G/strings/0x409/serialnumber
    echo "NCM + ACM"        > $G/configs/c.1/strings/0x409/configuration
    ln -s $G/functions/ncm.usb0 $G/configs/c.1/
    # The stock kernel has no ACM function: network only, then.
    [ -d $G/functions/acm.GS0 ] && ln -s $G/functions/acm.GS0 $G/configs/c.1/
    for i in $(seq 1 150); do          # dwc3 may probe late after module load
        udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
        [ -n "$udc" ] && break
        sleep 0.1
    done
    if [ -n "$udc" ]; then
        echo "$udc" > $G/UDC && log "usb gadget bound to $udc"
    else
        log "no USB device controller found"
    fi
}
setup_usb
stage 3

# Serial root shell on the USB ACM port, available in every mode
# (until switch_root replaces this process tree).
(
    while true; do
        [ -e /dev/ttyGS0 ] && setsid getty -n -l /bin/sh 115200 ttyGS0 vt100
        sleep 2
    done
) &
getty_loop=$!

# ---- hand over to systemd (root already mounted on /newroot) ----------------
handover() {
    log "switching root to $1"
    # Stop the serial shell loop: after switch_root its binaries are gone, so it
    # would spin (thousands of failed forks per second) and fight systemd's getty.
    kill "$getty_loop" 2>/dev/null
    killall getty telnetd udhcpd 2>/dev/null
    cp /tmp/init.log /newroot/run/initramfs.log 2>/dev/null
    umount /tmp
    umount /dev/pts
    for m in /dev /proc /sys; do mount --move $m /newroot$m; done
    exec switch_root /newroot /sbin/init
}

# ---- debug shell ------------------------------------------------------------
debug_shell() {
    log "entering debug mode: $*"
    devnodes
    ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up
    cat > /tmp/udhcpd.conf <<EOF
start 172.16.42.2
end 172.16.42.20
interface usb0
option subnet 255.255.255.0
lease_file /tmp/udhcpd.leases
EOF
    touch /tmp/udhcpd.leases
    udhcpd /tmp/udhcpd.conf
    telnetd -b 172.16.42.1:23 -l /bin/sh
    log "telnet 172.16.42.1 (debug shell); log: /tmp/init.log; pstore: /sys/fs/pstore"
    mkdir -p /sys/fs/pstore
    mount -t pstore pstore /sys/fs/pstore 2>/dev/null
    # Fastboot-return timer: started at the top (initdebug). Without
    # initdebug (a failed normal boot) start one here.
    grep -qw initdebug /proc/cmdline || ( sleep 600; [ -e /tmp/keep ] || reboot-bootloader ) &
    # A root prepared by hand on /newroot (scripts/ramroot.sh: Ubuntu in a
    # tmpfs, P3.3) is handed over when /tmp/switch appears.
    while [ ! -e /tmp/switch ]; do sleep 1; done
    grep -q " /newroot " /proc/mounts && [ -e /newroot/sbin/init ] || { log "/tmp/switch but no root on /newroot"; rm -f /tmp/switch; debug_shell "switch refused"; }
    handover "$(cat /tmp/switch)"
}

grep -qw initdebug /proc/cmdline && debug_shell "initdebug on cmdline"

# ---- find and mount the root (userdata partition) ---------------------------
find_userdata() {
    for u in /sys/class/block/*/uevent; do
        if grep -q '^PARTNAME=userdata$' "$u"; then
            echo "/dev/$(sed -n 's/^DEVNAME=//p' "$u")"
            return 0
        fi
    done
    return 1
}

root=""
for i in $(seq 1 150); do          # UFS can take a few seconds to probe
    devnodes
    root=$(find_userdata) && break
    sleep 0.2
done
[ -n "$root" ] || debug_shell "userdata partition not found"
log "userdata is $root"
# Never touch a userdata we didn't make (Android's data, a half-flashed
# image): build-rootfs.sh labels our ext4 "ubuntu".
blkid "$root" | grep -q 'LABEL="ubuntu"' || debug_shell "userdata has no ubuntu label; not mounting it"

mount -t ext4 -o rw,noatime "$root" /newroot || debug_shell "mounting $root failed"
[ -x /newroot/sbin/init ] || [ -L /newroot/sbin/init ] || debug_shell "/sbin/init missing in $root"

# ---- hand over to systemd ---------------------------------------------------
handover "$root"
