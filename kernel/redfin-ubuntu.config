# SPDX-License-Identifier: MIT
# Config fragment on top of LineageOS redbull_defconfig (4.19) for running
# Ubuntu 24.04 / systemd. Checklist from the Pixel 2's 4.4 fragment plus
# docs/research/bootchain.md. build-kernel.sh warns about every line here
# that did not survive olddefconfig.
CONFIG_LOCALVERSION="-redfin-ubuntu"
# CONFIG_LOCALVERSION_AUTO is not set

# systemd
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_SECCOMP=y
CONFIG_NAMESPACES=y
# IPC_NS needs both; Android turns SysV IPC off, Ubuntu software expects it.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y

# Android's empty static usermode helper disables every helper (modprobe
# autoload, coredumps); the firmware user-helper fallback stalls ~60 s per
# missing file because udev no longer answers it.
# CONFIG_STATIC_USERMODEHELPER is not set
# CONFIG_FW_LOADER_USER_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set

# SELinux stays built in but can be switched off with selinux=0.
CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# USB gadget networking + serial for the initramfs and Ubuntu (macOS: NCM).
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y

# Crash logs survive a warm reset.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Full LTO's final link needs more memory than an 8 GB Docker VM has
# (first build: ld killed, error 137). CFI needs LTO, so it goes too; AOSP's
# build.config.redbull.no-cfi does the same.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
