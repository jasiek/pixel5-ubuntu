# SPDX-License-Identifier: MIT
# Over arm64 defconfig, for the first mainline gate (P6.2/P6.4): reach our
# initramfs with USB networking + UFS. Boot-critical drivers built in (=y):
# our initramfs carries no mainline modules yet.
# SoC
CONFIG_SM_GCC_7250=y
CONFIG_PINCTRL_SM7250=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
# UFS
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
# (the QMP sub-drivers default to the parent, which defconfig sets =m)
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
# USB2 peripheral: NCM network + ACM serial, like our initramfs uses
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
# T1 signal: reboot("bootloader") via the PON reboot-mode; watchdog fed if
# the bootloader leaves it running. (pstore is useless here: Test 28.)
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_QCOM_WDT=y
# Our initramfs is LZ4 legacy (the bootloader prepends nothing on v2, but
# keep it identical to the downstream image)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_EXT4_FS=y
# No EFI stub: with the "MZ" PE header the kernel died before userspace
# (Tests 29-30, watchdog reset); nairo found the same on Motorola's ABL.
# CONFIG_EFI is not set
# P6.4 charger + fuel gauge (nairo 0017/0046), loaded from the rootfs
CONFIG_CHARGER_QCOM_SMB2=m
CONFIG_BATTERY_QCOM_QG=m
# P6.4 haptics (local patch 0002)
CONFIG_INPUT_DRV2624_HAPTICS=m
# P6.4 display: S6E3HC2 panel (local patch 0004); DSI refgen supply
CONFIG_DRM_PANEL_SAMSUNG_S6E3HC2=m
CONFIG_REGULATOR_QCOM_REFGEN=m
# P6.4 touch: S6SY79x over SPI (local patch 0005)
CONFIG_TOUCHSCREEN_S6SY761=m
# P6.4 audio: CS35L41 speaker amps (I2C)
CONFIG_SND_SOC_CS35L41_I2C=m
