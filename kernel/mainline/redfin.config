# SPDX-License-Identifier: MIT
# Over arm64 defconfig, for the first mainline gate (P6.2/P6.4): reach our
# initramfs with USB networking + UFS. Boot-critical drivers built in (=y):
# our initramfs carries no mainline modules yet.
# SoC
CONFIG_SM_GCC_7250=y
CONFIG_PINCTRL_SM7250=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
# UFS
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
# (the QMP sub-drivers default to the parent, which defconfig sets =m)
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
# USB2 peripheral: NCM network + ACM serial, like our initramfs uses
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
# Debug without UART: ramoops (region from our board DTS, P6.3)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# Our initramfs is LZ4 legacy (the bootloader prepends nothing on v2, but
# keep it identical to the downstream image)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_EXT4_FS=y
