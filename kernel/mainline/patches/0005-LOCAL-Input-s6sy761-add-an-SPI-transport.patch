index 1bd4ddf..d20e746 100644
--- a/drivers/input/touchscreen/s6sy761.c
+++ b/drivers/input/touchscreen/s6sy761.c
@@ -3,9 +3,14 @@
 //
 // Copyright (c) 2017 Samsung Electronics Co., Ltd.
 // Copyright (c) 2017 Andi Shyti <andi@etezian.org>
+//
+// SPI transport: the framing of Samsung's sec_ts driver in Google's redbull
+// kernel (drivers/input/touchscreen/sec_touch, GPL-2.0), used by the S6SY79x
+// of the Pixel 5.
 
 #include <linux/unaligned.h>
 #include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/input/mt.h>
 #include <linux/input/touchscreen.h>
@@ -14,6 +19,7 @@
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
 #include <linux/regulator/consumer.h>
+#include <linux/spi/spi.h>
 
 /* commands */
 #define S6SY761_SENSE_ON		0x10
@@ -93,13 +99,49 @@
 
 #define S6SY761_DEV_NAME	"s6sy761"
 
+/* after power-on/reset: poll for the boot-complete event */
+#define S6SY761_BOOT_DELAY_MS		70
+#define S6SY761_BOOT_POLL_MS		20
+#define S6SY761_BOOT_POLL_COUNT		50
+
+/*
+ * SPI framing. Write: sync, 16-bit length of reg + data, 16-bit 0, reg,
+ * data, checksum (byte sum). Read request: sync, 16-bit 1, 16-bit length,
+ * reg, checksum; then, after a short delay, a separate read of sync,
+ * lengths, reg, status, data, checksum (over all bytes before it).
+ * Every transfer is zero-padded to a multiple of 4 bytes.
+ */
+#define S6SY761_SPI_SYNC		0xaa
+#define S6SY761_SPI_HDR			5
+#define S6SY761_SPI_RD_HDR		7
+#define S6SY761_SPI_BUF_SIZE		ALIGN(S6SY761_SPI_RD_HDR + \
+					      S6SY761_EVENT_SIZE * \
+					      S6SY761_EVENT_COUNT + 1, 4)
+#define S6SY761_SPI_RETRIES		3
+
 enum s6sy761_regulators {
 	S6SY761_REGULATOR_VDD,
 	S6SY761_REGULATOR_AVDD,
 };
 
+struct s6sy761_data;
+
+struct s6sy761_bus_ops {
+	int (*read)(struct s6sy761_data *sdata, u8 reg, u8 *buf, u16 len);
+	int (*write)(struct s6sy761_data *sdata, u8 reg, const u8 *buf,
+		     u16 len);
+};
+
 struct s6sy761_data {
+	struct device *dev;
+	int irq;
+	const struct s6sy761_bus_ops *ops;
 	struct i2c_client *client;
+	struct spi_device *spi;
+	struct mutex io_lock;	/* SPI tx/rx buffers */
+	u8 *tx;
+	u8 *rx;
+	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data regulators[2];
 	struct input_dev *input;
 	struct touchscreen_properties prop;
@@ -110,35 +152,213 @@ struct s6sy761_data {
 	u8 tx_channel;
 };
 
-/*
- * We can't simply use i2c_smbus_read_i2c_block_data because we
- * need to read more than 255 bytes
- */
-static int s6sy761_read_events(struct s6sy761_data *sdata, u16 n_events)
+static int s6sy761_i2c_read(struct s6sy761_data *sdata, u8 reg,
+			    u8 *buf, u16 len)
 {
-	u8 cmd = S6SY761_READ_ALL_EVENT;
+	struct i2c_client *client = sdata->client;
 	struct i2c_msg msgs[2] = {
 		{
-			.addr	= sdata->client->addr,
+			.addr	= client->addr,
 			.len	= 1,
-			.buf	= &cmd,
+			.buf	= &reg,
 		},
 		{
-			.addr	= sdata->client->addr,
+			.addr	= client->addr,
 			.flags	= I2C_M_RD,
-			.len	= (n_events * S6SY761_EVENT_SIZE),
-			.buf	= sdata->data + S6SY761_EVENT_SIZE,
+			.len	= len,
+			.buf	= buf,
 		},
 	};
 	int ret;
 
-	ret = i2c_transfer(sdata->client->adapter, msgs, ARRAY_SIZE(msgs));
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
 	if (ret < 0)
 		return ret;
 
 	return ret == ARRAY_SIZE(msgs) ? 0 : -EIO;
 }
 
+static int s6sy761_i2c_write(struct s6sy761_data *sdata, u8 reg,
+			     const u8 *buf, u16 len)
+{
+	u8 msg[3];
+	int ret;
+
+	if (len > sizeof(msg) - 1)
+		return -EINVAL;
+
+	msg[0] = reg;
+	if (len)
+		memcpy(msg + 1, buf, len);
+
+	ret = i2c_master_send(sdata->client, msg, len + 1);
+	if (ret < 0)
+		return ret;
+
+	return ret == len + 1 ? 0 : -EIO;
+}
+
+static const struct s6sy761_bus_ops s6sy761_i2c_ops = {
+	.read	= s6sy761_i2c_read,
+	.write	= s6sy761_i2c_write,
+};
+
+static int s6sy761_spi_write(struct s6sy761_data *sdata, u8 reg,
+			     const u8 *buf, u16 len)
+{
+	u8 *tx = sdata->tx;
+	unsigned int n, i;
+	int ret = -EIO, retry;
+	u8 csum = 0;
+
+	if (ALIGN(S6SY761_SPI_HDR + 1 + len + 1, 4) > S6SY761_SPI_BUF_SIZE)
+		return -EINVAL;
+
+	guard(mutex)(&sdata->io_lock);
+
+	tx[0] = S6SY761_SPI_SYNC;
+	tx[1] = (len + 1) >> 8;
+	tx[2] = (len + 1) & 0xff;
+	tx[3] = 0;
+	tx[4] = 0;
+	tx[5] = reg;
+	if (len)
+		memcpy(tx + S6SY761_SPI_HDR + 1, buf, len);
+
+	n = S6SY761_SPI_HDR + 1 + len;
+	for (i = 0; i < n; i++)
+		csum += tx[i];
+	tx[n++] = csum;
+	memset(tx + n, 0, 3);
+	n = ALIGN(n, 4);
+
+	for (retry = 0; retry < S6SY761_SPI_RETRIES; retry++) {
+		ret = spi_write(sdata->spi, tx, n);
+		if (!ret)
+			return 0;
+		usleep_range(1000, 1100);
+	}
+
+	dev_err_ratelimited(sdata->dev, "write %#x failed: %d\n", reg, ret);
+	return ret;
+}
+
+/* time the controller needs to prepare a reply (downstream sec_ts) */
+static unsigned int s6sy761_spi_delay_us(u8 reg)
+{
+	switch (reg) {
+	case S6SY761_READ_ALL_EVENT:
+		return 500;
+	case S6SY761_FIRMWARE_INTEGRITY:
+		return 20000;
+	default:
+		return 100;
+	}
+}
+
+static int s6sy761_spi_read(struct s6sy761_data *sdata, u8 reg,
+			    u8 *buf, u16 len)
+{
+	unsigned int delay_us = s6sy761_spi_delay_us(reg);
+	unsigned int rlen = ALIGN(S6SY761_SPI_RD_HDR + len + 1, 4);
+	u8 *tx = sdata->tx, *rx = sdata->rx;
+	int ret = -EIO, retry;
+	unsigned int i;
+	u8 csum;
+
+	if (rlen > S6SY761_SPI_BUF_SIZE)
+		return -EINVAL;
+
+	guard(mutex)(&sdata->io_lock);
+
+	tx[0] = S6SY761_SPI_SYNC;
+	tx[1] = 0x00;
+	tx[2] = 0x01;
+	tx[3] = len >> 8;
+	tx[4] = len & 0xff;
+	tx[5] = reg;
+	for (i = 0, csum = 0; i < S6SY761_SPI_HDR + 1; i++)
+		csum += tx[i];
+	tx[6] = csum;
+	tx[7] = 0;
+
+	for (retry = 0; retry < S6SY761_SPI_RETRIES; retry++) {
+		if (retry)
+			usleep_range(1000, 1100);
+
+		ret = spi_write(sdata->spi, tx, 8);
+		if (ret)
+			continue;
+
+		fsleep(delay_us);
+
+		ret = spi_read(sdata->spi, rx, rlen);
+		if (ret)
+			continue;
+
+		for (i = 0, csum = 0; i < S6SY761_SPI_RD_HDR + len; i++)
+			csum += rx[i];
+
+		if (rx[0] != S6SY761_SPI_SYNC || rx[5] != reg ||
+		    rx[S6SY761_SPI_RD_HDR + len] != csum) {
+			dev_dbg(sdata->dev, "read %#x: bad reply %*ph\n",
+				reg, 8, rx);
+			ret = -EIO;
+			continue;
+		}
+
+		memcpy(buf, rx + S6SY761_SPI_RD_HDR, len);
+		return 0;
+	}
+
+	dev_err_ratelimited(sdata->dev, "read %#x failed: %d (%*ph)\n",
+			    reg, ret, 8, rx);
+	return ret;
+}
+
+static const struct s6sy761_bus_ops s6sy761_spi_ops = {
+	.read	= s6sy761_spi_read,
+	.write	= s6sy761_spi_write,
+};
+
+static int s6sy761_read(struct s6sy761_data *sdata, u8 reg, u8 *buf, u16 len)
+{
+	return sdata->ops->read(sdata, reg, buf, len);
+}
+
+static int s6sy761_read_byte(struct s6sy761_data *sdata, u8 reg)
+{
+	u8 val;
+	int ret;
+
+	ret = s6sy761_read(sdata, reg, &val, 1);
+
+	return ret ? ret : val;
+}
+
+static int s6sy761_write(struct s6sy761_data *sdata, u8 reg,
+			 const u8 *buf, u16 len)
+{
+	return sdata->ops->write(sdata, reg, buf, len);
+}
+
+static int s6sy761_command(struct s6sy761_data *sdata, u8 cmd)
+{
+	return s6sy761_write(sdata, cmd, NULL, 0);
+}
+
+static int s6sy761_write_byte(struct s6sy761_data *sdata, u8 reg, u8 val)
+{
+	return s6sy761_write(sdata, reg, &val, 1);
+}
+
+static int s6sy761_read_events(struct s6sy761_data *sdata, u16 n_events)
+{
+	return s6sy761_read(sdata, S6SY761_READ_ALL_EVENT,
+			    sdata->data + S6SY761_EVENT_SIZE,
+			    n_events * S6SY761_EVENT_SIZE);
+}
+
 static void s6sy761_report_coordinates(struct s6sy761_data *sdata,
 				       u8 *event, u8 tid)
 {
@@ -226,12 +446,10 @@ static irqreturn_t s6sy761_irq_handler(int irq, void *dev)
 	int ret;
 	u8 n_events;
 
-	ret = i2c_smbus_read_i2c_block_data(sdata->client,
-					    S6SY761_READ_ONE_EVENT,
-					    S6SY761_EVENT_SIZE,
-					    sdata->data);
+	ret = s6sy761_read(sdata, S6SY761_READ_ONE_EVENT, sdata->data,
+			   S6SY761_EVENT_SIZE);
 	if (ret < 0) {
-		dev_err(&sdata->client->dev, "failed to read events\n");
+		dev_err(sdata->dev, "failed to read events\n");
 		return IRQ_HANDLED;
