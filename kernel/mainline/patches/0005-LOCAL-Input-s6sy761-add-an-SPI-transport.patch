@@ -288,10 +506,33 @@ static struct attribute *s6sy761_sysfs_attrs[] = {
 };
 ATTRIBUTE_GROUPS(s6sy761_sysfs);
 
-static int s6sy761_power_on(struct s6sy761_data *sdata)
+static int s6sy761_wait_boot(struct s6sy761_data *sdata)
