From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pixel5 <pixel5@localhost>
Date: Sat, 21 Nov 2026 12:00:00 +0000
Subject: [PATCH 2/2] LOCAL: ASoC: rt5514: capture through the RT5514P DSP

On the Google Pixel 5 (RT5514P, VENDOR_ID1 0x80) the I2S/TDM capture
stream comes from the RT5514 DSP; the plain ADC path gives silence.
Google's downstream driver loads rt5514p_dsp_fw1..4.bin over SPI, starts
the DSP and switches its function to WOV_I2S_SENSOR for each recording.
Register values, firmware names and load addresses are from that driver.

- "DSP I2S Capture Switch" (one way, RT5514P only): applies the RT5514P
  I2C patch and DSP clock set-up, routes the RT5514 SPI port to the AP
  (GPIO5 low), loads and reads back the four firmware files, starts the
  DSP and waits for it to run;
- hw_params/hw_free switch the DSP function to/from WOV_I2S_SENSOR and
  set the sample width; nothing else, as downstream;
- while the DSP runs, the DAI's set_fmt/set_sysclk/set_pll/set_tdm_slot
  do nothing: the firmware sets the interface and its clocks (PLL2 from
  BCLK) itself, and downstream's machine driver never calls them;
- while the DSP runs, every codec register is volatile: the firmware
  writes clock and power registers too, and DAPM's read-modify-write
  from the cache overwrote them (CLK_CTRL1 back to its default DMIC
  clock divider, so the microphones gave no signal);
- the DSP registers the above uses are readable over I2C;
- optional reset-gpios: a failed load can leave the chip reading zeros
  on I2C until reset (at boot, about every second time, cause unknown),
  so the control resets the chip, re-syncs the cache and retries, up to
  three attempts.
---
diff --git a/sound/soc/codecs/rt5514.c b/sound/soc/codecs/rt5514.c
index a33fbc9fb..e563c69ec 100644
--- a/sound/soc/codecs/rt5514.c
+++ b/sound/soc/codecs/rt5514.c
@@ -17,6 +17,7 @@
 #include <linux/i2c.h>
 #include <linux/platform_device.h>
 #include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
 #include <sound/core.h>
 #include <sound/pcm.h>
 #include <sound/pcm_params.h>
@@ -145,6 +146,16 @@ static void rt5514_enable_dsp_prepare(struct rt5514_priv *rt5514)
 
 static bool rt5514_volatile_register(struct device *dev, unsigned int reg)
 {
+	struct rt5514_priv *rt5514 = dev_get_drvdata(dev);
+
+	/*
+	 * Once the RT5514P DSP runs, its firmware writes the clock, PLL and
+	 * power registers too: read-modify-write must see the hardware, or
+	 * DAPM puts cached defaults over them (CLK_CTRL1 DMIC divider).
+	 */
+	if (rt5514 && rt5514->dsp_i2s)
+		return true;
+
 	switch (reg) {
 	case RT5514_VENDOR_ID1:
 	case RT5514_VENDOR_ID2:
@@ -263,6 +274,11 @@ static bool rt5514_i2c_readable_register(struct device *dev,
 	case RT5514_DSP_MAPPING | RT5514_DSP_CTRL4:
 	case RT5514_DSP_MAPPING | RT5514_VENDOR_ID1:
 	case RT5514_DSP_MAPPING | RT5514_VENDOR_ID2:
+	/* RT5514P DSP: run/filter-reset flag, GPIO5 (SPI switch), DSP mode */
+	case 0x18001014:
+	case 0x18002074:
+	case 0x18002fac:
+	case 0x18002fb0:
 		return true;
 
 	default:
@@ -283,6 +299,203 @@ static const DECLARE_TLV_DB_RANGE(bst_tlv,
 
 static const DECLARE_TLV_DB_SCALE(adc_vol_tlv, -1725, 75, 0);
 
+/*
+ * Google Pixel 5 (RT5514P): its I2S/TDM stream comes from the RT5514 DSP,
+ * not from the plain ADC path (Google's downstream rt5514.c forces the DSP
+ * on for every recording). Register values, firmware names and load
+ * addresses below are from that driver.
+ */
+#define RT5514_DSP_WOV_TYPE		0x18002fac
+#define RT5514_DSP_FUNC			0x18002fb0
+#define RT5514_DSP_CHRE_INFORM		0x18002fec
+#define RT5514_DSP_WOV_BOTH		0
+#define RT5514_DSP_FUNC_WOV_SENSOR	1
+#define RT5514_DSP_FUNC_WOV_I2S_SENSOR	3
+
+static const struct reg_sequence rt5514p_i2c_patch[] = {
+	{0xfafafafa, 0x00000001},
+	{0x18002000, 0x000010ec},
+	{0x18002004, 0x00808f81},
+	{0x18002008, 0x00770000},
+	{0x18002f08, 0x00000006},
+	{0x18002f10, 0x00000000},
+	{0x18002f10, 0x00000001},
+	{0xfafafafa, 0x00000000},
+	{0x18001104, 0x00000007},
+	{0x18001108, 0x00000000},
+	{0x1800110c, 0x00000000},
+	{0x18001100, 0x0000031f},
+	{0x18002000, 0x000010ec},
+};
+
+/* rt5514_enable_dsp_prepare(), RT5514P branch */
+static const struct reg_sequence rt5514p_dsp_prepare[] = {
+	{0x18002004, 0x00808f81},
+	{0x18002008, 0x00770000},
+	{0x18002200, 0x00028704},	/* LDO current limit */
+	{0x18002070, 0x00000040},	/* pin config */
+	{0x18002240, 0x0000001e},	/* PLL3 = 1.3 MHz x 31 = 40 MHz */
+	{0x18002100, 0x0000000b},	/* PLL3 source RCOSC */
+	{0x18002f08, 0x00000005},	/* DSP clock from PLL3, on */
+	{0x18001118, 0x00000001},	/* reduce DSP power */
+	{0x18002fcc, 0x00000001},	/* DSP buffer: mono */
+	{0x18002124, 0x00220012},	/* DFLL reset */
+	{0x18002110, 0x000104c4},	/* DFLL m/n */
+	{0x18002124, 0x80220012},
+	{0x18002124, 0xc0220012},
+};
+
+static const char * const rt5514p_fw_name[4] = {
+	"rt5514p_dsp_fw1.bin", "rt5514p_dsp_fw2.bin",
+	"rt5514p_dsp_fw3.bin", "rt5514p_dsp_fw4.bin",
+};
+
+static void rt5514p_dsp_filter_reset(struct rt5514_priv *rt5514)
+{
+	/* resets the DSP filter and its buffer pointers */
+	regmap_write(rt5514->i2c_regmap, 0x18001014, 1);
+	regmap_write(rt5514->i2c_regmap, RT5514_DSP_CHRE_INFORM, 0);
+}
+
+static int rt5514p_dsp_load(struct rt5514_priv *rt5514)
+{
+	struct device *dev = rt5514->component->dev;
+	u32 addr[4] = { 0x4fe00000, 0x4ff00000, 0x4fe98000, 0x4fea8000 };
+	u32 model[2] = { 0, 0 };
+	const struct firmware *fw;
+	unsigned int val = 1;
+	int i, ret;
+
+	regmap_multi_reg_write(rt5514->i2c_regmap, rt5514p_i2c_patch,
+			       ARRAY_SIZE(rt5514p_i2c_patch));
+	regmap_multi_reg_write(rt5514->i2c_regmap, rt5514p_dsp_prepare,
+			       ARRAY_SIZE(rt5514p_dsp_prepare));
+	regmap_write(rt5514->i2c_regmap, RT5514_DSP_WOV_TYPE,
+		     RT5514_DSP_WOV_BOTH);
+	/*
+	 * RT5514 GPIO5 drives the switch that gives its SPI slave port to
+	 * the AP (low) or to the ADSP's CHRE (high). Keep it on the AP;
+	 * the AP's handshake GPIO (TLMM 66) is held high by pinctrl.
+	 */
+	regmap_update_bits(rt5514->i2c_regmap, 0x18002070, BIT(8), BIT(8));
+	regmap_update_bits(rt5514->i2c_regmap, 0x18002074,
+			   BIT(21) | BIT(22), BIT(22));
+
+	for (i = 0; i < 4; i++) {
+		ret = request_firmware(&fw, rt5514p_fw_name[i], dev);
+		if (ret)
+			return ret;
+
+		/* fw1 starts with the sound model address (if not default) */
+		if (i == 0 && fw->size >= sizeof(model)) {
+			memcpy(model, fw->data, sizeof(model));
+			if (model[0])
+				addr[2] = model[0];
+		}
+#if IS_ENABLED(CONFIG_SND_SOC_RT5514_SPI)
+		ret = rt5514_spi_burst_write(addr[i], fw->data, fw->size);
+		if (!ret) {
+			/* read it back, before fw1's model pointer is patched */
+			size_t n = ALIGN(fw->size, 8);
+			u8 *buf = kzalloc(n, GFP_KERNEL);
+
+			ret = buf ? rt5514_spi_burst_read(addr[i], buf, n) : -ENOMEM;
+			if (!ret && memcmp(buf, fw->data, fw->size))
+				ret = -EIO;
+			kfree(buf);
+		}
+		if (!ret && i == 2 && model[0]) {
+			addr[3] = addr[2] + ((fw->size / 8) + 1) * 8;
+			ret = rt5514_spi_burst_write(addr[0], (u8 *)&addr[2], 8);
+		}
+#else
+		ret = -ENODEV;
+#endif
+		if (ret)
+			dev_err(dev, "DSP: %s (%zu bytes) at 0x%08x failed: %d\n",
+				rt5514p_fw_name[i], fw->size, addr[i], ret);
+		release_firmware(fw);
+		if (ret)
+			return ret;
+	}
+
+	regmap_write(rt5514->i2c_regmap, 0x18002f08, 0x0000000b); /* 40 MHz */
+	regmap_write(rt5514->i2c_regmap, 0x18002f00, 0x00055148); /* run */
+	usleep_range(10000, 10005);
+	regmap_write(rt5514->i2c_regmap, RT5514_DSP_FUNC,
+		     RT5514_DSP_FUNC_WOV_SENSOR);
+	rt5514p_dsp_filter_reset(rt5514);
+
+	/* the DSP clears the filter reset request when it runs */
+	for (i = 0; i < 10; i++) {
+		regmap_read(rt5514->i2c_regmap, 0x18001014, &val);
+		if (!val)
+			break;
+		usleep_range(10000, 15000);
+	}
+	if (val)
+		dev_err(dev, "DSP did not start\n");
+	else
+		dev_info(dev, "DSP running\n");
+
+	return val ? -EIO : 0;
+}
+
+static int rt5514_dsp_i2s_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct rt5514_priv *rt5514 = snd_soc_component_get_drvdata(component);
+
+	ucontrol->value.integer.value[0] = rt5514->dsp_i2s;
+	return 0;
+}
+
+static int rt5514_dsp_i2s_put(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct rt5514_priv *rt5514 = snd_soc_component_get_drvdata(component);
+	unsigned int id;
+	int ret = 0, try;
+
+	/* one way: load and start once, while no stream runs */
+	if (!ucontrol->value.integer.value[0] || rt5514->dsp_i2s)
+		return 0;
+	if (snd_soc_component_active(component))
+		return -EBUSY;
+
+	/*
+	 * A failed load can leave the chip answering zeros on I2C until it
+	 * is reset (seen at boot on the Pixel 5, cause unknown): reset and
+	 * try again.
+	 */
+	for (try = 0; try < 3; try++) {
+		if (try) {
+			dev_warn(component->dev, "DSP load attempt %d failed: %d\n",
+				 try, ret);
+			if (!rt5514->reset)
+				break;
+			gpiod_set_value_cansleep(rt5514->reset, 1);
+			usleep_range(1000, 2000);
+			gpiod_set_value_cansleep(rt5514->reset, 0);
+			usleep_range(10000, 15000);
+			regcache_mark_dirty(rt5514->regmap);
+			regcache_sync(rt5514->regmap);
+		}
+		/* only the RT5514P sequence and firmware are known */
+		id = 0;
+		regmap_read(rt5514->regmap, RT5514_VENDOR_ID1, &id);
+		ret = id == 0x80 ? rt5514p_dsp_load(rt5514) : -ENODEV;
+		if (!ret)
+			break;
+	}
+	if (ret)
+		return ret;
+	rt5514->dsp_i2s = true;
+	return 1;
+}
+
 static int rt5514_dsp_voice_wake_up_get(struct snd_kcontrol *kcontrol,
 		struct snd_ctl_elem_value *ucontrol)
 {
@@ -433,6 +646,8 @@ static const struct snd_kcontrol_new rt5514_snd_controls[] = {
 		adc_vol_tlv),
 	SOC_SINGLE_EXT("DSP Voice Wake Up", SND_SOC_NOPM, 0, 1, 0,
 		rt5514_dsp_voice_wake_up_get, rt5514_dsp_voice_wake_up_put),
+	SOC_SINGLE_BOOL_EXT("DSP I2S Capture Switch", 0,
+		rt5514_dsp_i2s_get, rt5514_dsp_i2s_put),
 };
 
 /* ADC Mixer*/
@@ -756,6 +971,16 @@ static int rt5514_hw_params(struct snd_pcm_substream *substream,
 	int pre_div, bclk_ms, frame_size;
 	unsigned int val_len = 0;
 
+	if (rt5514->dsp_i2s) {
+		/* the DSP streams to I2S; downstream sets nothing else */
+		regmap_write(rt5514->i2c_regmap, RT5514_DSP_FUNC,
+			     RT5514_DSP_FUNC_WOV_I2S_SENSOR);
+		rt5514p_dsp_filter_reset(rt5514);
+		regmap_update_bits(rt5514->i2c_regmap, 0x18002010, 0x3,
+				   params_width(params) == 24 ? 0x2 : 0x0);
+		return 0;
+	}
+
 	rt5514->lrck = params_rate(params);
 	pre_div = rl6231_get_clk_info(rt5514->sysclk, rt5514->lrck);
 	if (pre_div < 0) {
@@ -1140,12 +1365,66 @@ static const u64 rt5514_selectable_formats =
 	SND_SOC_POSSIBLE_DAIFMT_IB_NF	|
 	SND_SOC_POSSIBLE_DAIFMT_IB_IF;
 
+static int rt5514_hw_free(struct snd_pcm_substream *substream,
+			  struct snd_soc_dai *dai)
+{
+	struct rt5514_priv *rt5514 =
+		snd_soc_component_get_drvdata(dai->component);
+
+	if (rt5514->dsp_i2s) {
+		regmap_write(rt5514->i2c_regmap, RT5514_DSP_FUNC,
+			     RT5514_DSP_FUNC_WOV_SENSOR);
+		rt5514p_dsp_filter_reset(rt5514);
+	}
+	return 0;
+}
+
+/*
+ * While the RT5514P DSP produces the I2S stream, its firmware owns the
+ * interface format and clocks: downstream never calls these on that link.
+ */
+static bool rt5514_dsp_owns_aif(struct snd_soc_dai *dai)
+{
+	struct rt5514_priv *rt5514 =
+		snd_soc_component_get_drvdata(dai->component);
+
+	return rt5514->dsp_i2s;
+}
+
+static int rt5514_dsp_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	return rt5514_dsp_owns_aif(dai) ? 0 : rt5514_set_dai_fmt(dai, fmt);
+}
+
+static int rt5514_dsp_set_sysclk(struct snd_soc_dai *dai, int clk_id,
+				 unsigned int freq, int dir)
+{
+	return rt5514_dsp_owns_aif(dai) ? 0 :
+		rt5514_set_dai_sysclk(dai, clk_id, freq, dir);
+}
+
+static int rt5514_dsp_set_pll(struct snd_soc_dai *dai, int pll_id, int source,
+			      unsigned int freq_in, unsigned int freq_out)
+{
+	return rt5514_dsp_owns_aif(dai) ? 0 :
+		rt5514_set_dai_pll(dai, pll_id, source, freq_in, freq_out);
+}
+
+static int rt5514_dsp_set_tdm_slot(struct snd_soc_dai *dai,
+				   unsigned int tx_mask, unsigned int rx_mask,
+				   int slots, int slot_width)
+{
+	return rt5514_dsp_owns_aif(dai) ? 0 :
+		rt5514_set_tdm_slot(dai, tx_mask, rx_mask, slots, slot_width);
+}
+
 static const struct snd_soc_dai_ops rt5514_aif_dai_ops = {
 	.hw_params = rt5514_hw_params,
-	.set_fmt = rt5514_set_dai_fmt,
-	.set_sysclk = rt5514_set_dai_sysclk,
-	.set_pll = rt5514_set_dai_pll,
-	.set_tdm_slot = rt5514_set_tdm_slot,
+	.hw_free = rt5514_hw_free,
+	.set_fmt = rt5514_dsp_set_fmt,
+	.set_sysclk = rt5514_dsp_set_sysclk,
+	.set_pll = rt5514_dsp_set_pll,
+	.set_tdm_slot = rt5514_dsp_set_tdm_slot,
 	.auto_selectable_formats = &rt5514_selectable_formats,
 	.num_auto_selectable_formats = 1,
 };
@@ -1273,6 +1552,11 @@ static int rt5514_i2c_probe(struct i2c_client *i2c)
 	else
 		rt5514_parse_dp(rt5514, &i2c->dev);
 
+	rt5514->reset = devm_gpiod_get_optional(&i2c->dev, "reset",
+						GPIOD_OUT_LOW);
+	if (IS_ERR(rt5514->reset))
+		return PTR_ERR(rt5514->reset);
+
 	rt5514->mclk = devm_clk_get_optional(&i2c->dev, "mclk");
 	if (IS_ERR(rt5514->mclk))
 		return PTR_ERR(rt5514->mclk);
diff --git a/sound/soc/codecs/rt5514.h b/sound/soc/codecs/rt5514.h
index 75755599f..3c2056aa6 100644
--- a/sound/soc/codecs/rt5514.h
+++ b/sound/soc/codecs/rt5514.h
@@ -281,6 +281,8 @@ struct rt5514_priv {
 	int pll_out;
 	int dsp_enabled;
 	unsigned int pll3_cal_value;
+	bool dsp_i2s;		/* RT5514P DSP produces the I2S stream */
+	struct gpio_desc *reset;	/* optional, active low */
 };
 
 #endif /* __RT5514_H__ */
