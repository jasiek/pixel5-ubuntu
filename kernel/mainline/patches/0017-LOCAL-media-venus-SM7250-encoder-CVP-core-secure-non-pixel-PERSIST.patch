 	enum dpb_buf_owner owned_by;
 	u32 dpb_out_tag;
 };
@@ -230,6 +231,44 @@ int venus_helper_alloc_dpb_bufs(struct venus_inst *inst)
 }
 EXPORT_SYMBOL_GPL(venus_helper_alloc_dpb_bufs);
 
+/* downstream: an encoder's INTERNAL_PERSIST is always CP_NON_PIXEL memory */
+static bool intbuf_is_secnp(struct venus_inst *inst, u32 type)
+{
+	return inst->core->secnp.pool &&
+	       inst->session_type == VIDC_SESSION_TYPE_ENC &&
+	       type == HFI_BUFFER_INTERNAL_PERSIST;
+}
+
+static int intbuf_alloc(struct venus_inst *inst, struct intbuf *buf)
+{
+	struct venus_core *core = inst->core;
+
+	if (intbuf_is_secnp(inst, buf->type)) {
+		buf->da = gen_pool_alloc(core->secnp.pool, buf->size);
+		if (!buf->da) {
+			dev_err(core->dev, "non-pixel pool exhausted (%zu bytes)\n",
+				buf->size);
+			return -ENOMEM;
+		}
+		buf->secnp = true;
+		return 0;
+	}
+
+	buf->attrs = DMA_ATTR_WRITE_COMBINE | DMA_ATTR_NO_KERNEL_MAPPING;
+	buf->va = dma_alloc_attrs(core->dev, buf->size, &buf->da, GFP_KERNEL,
+				  buf->attrs);
+	return buf->va ? 0 : -ENOMEM;
+}
+
+static void intbuf_free(struct venus_inst *inst, struct intbuf *buf)
+{
+	if (buf->secnp)
+		gen_pool_free(inst->core->secnp.pool, buf->da, buf->size);
+	else
+		dma_free_attrs(inst->core->dev, buf->size, buf->va, buf->da,
+			       buf->attrs);
+}
+
 static int intbufs_set_buffer(struct venus_inst *inst, u32 type)
 {
 	struct venus_core *core = inst->core;
@@ -256,14 +295,9 @@ static int intbufs_set_buffer(struct venus_inst *inst, u32 type)
 
 		buf->type = bufreq.type;
 		buf->size = bufreq.size;
-		buf->attrs = DMA_ATTR_WRITE_COMBINE |
-			     DMA_ATTR_NO_KERNEL_MAPPING;
-		buf->va = dma_alloc_attrs(dev, buf->size, &buf->da, GFP_KERNEL,
-					  buf->attrs);
-		if (!buf->va) {
-			ret = -ENOMEM;
+		ret = intbuf_alloc(inst, buf);
+		if (ret)
 			goto fail;
-		}
 
 		memset(&bd, 0, sizeof(bd));
 		bd.buffer_size = buf->size;
@@ -283,7 +317,7 @@ static int intbufs_set_buffer(struct venus_inst *inst, u32 type)
 	return 0;
 
 dma_free:
-	dma_free_attrs(dev, buf->size, buf->va, buf->da, buf->attrs);
+	intbuf_free(inst, buf);
 fail:
 	kfree(buf);
 	return ret;
@@ -305,8 +339,7 @@ static int intbufs_unset_buffers(struct venus_inst *inst)
 		ret = hfi_session_unset_buffers(inst, &bd);
 
 		list_del_init(&buf->list);
-		dma_free_attrs(inst->core->dev, buf->size, buf->va, buf->da,
-			       buf->attrs);
+		intbuf_free(inst, buf);
 		kfree(buf);
 	}
 
@@ -395,8 +428,7 @@ int venus_helper_intbufs_realloc(struct venus_inst *inst)
 
 		ret = hfi_session_unset_buffers(inst, &bd);
 
-		dma_free_attrs(inst->core->dev, buf->size, buf->va, buf->da,
-			       buf->attrs);
+		intbuf_free(inst, buf);
 
 		list_del_init(&buf->list);
 		kfree(buf);
