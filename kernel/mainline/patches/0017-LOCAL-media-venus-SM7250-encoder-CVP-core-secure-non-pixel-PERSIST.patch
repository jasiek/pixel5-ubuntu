diff --git a/drivers/media/platform/qcom/venus/firmware.c b/drivers/media/platform/qcom/venus/firmware.c
index 3a38ff985..7e2b0338a 100644
--- a/drivers/media/platform/qcom/venus/firmware.c
+++ b/drivers/media/platform/qcom/venus/firmware.c
@@ -365,6 +365,139 @@ int venus_firmware_init(struct venus_core *core)
 	return ret;
 }
 
+/* inside the content-protection non-pixel range TZ sets up (cp_nonpixel_*) */
+#define VENUS_SECNP_IOVA	0x10000000
+
+static int venus_secnp_assign(struct venus_core *core, bool to_vm)
+{
+	struct venus_secnp *s = &core->secnp;
+	struct qcom_scm_vmperm perm = {
+		.vmid = to_vm ? s->vmid : QCOM_SCM_VMID_HLOS,
+		.perm = to_vm ? QCOM_SCM_PERM_RW : QCOM_SCM_PERM_RWX,
+	};
+	u64 src = to_vm ? BIT(QCOM_SCM_VMID_HLOS) : BIT(s->vmid);
+
+	return qcom_scm_assign_mem(s->phys, s->size, &src, &perm, 1);
+}
+
+/*
+ * IRIS1 (SM7250): the encoder's CVP core reads its INTERNAL_PERSIST buffer
+ * through the secure non-pixel stream ID, even in a non-secure session, as
+ * downstream allocates it (CP_NON_PIXEL). Give that stream ID its own domain
+ * ("non-pixel" child: iommus, qcom,iommu-vmid, memory-region), hand a no-map
+ * carveout to the VM and map it once; encoder PERSIST buffers come from it.
+ * Without it the encoder is not registered (see venc_probe()).
+ */
+void venus_secnp_init(struct venus_core *core)
+{
+	struct venus_secnp *s = &core->secnp;
+	struct platform_device_info info = {};
+	struct device *dev = core->dev;
+	struct platform_device *pdev;
+	struct iommu_domain *domain;
+	struct device_node *np, *mem;
+	struct reserved_mem *rmem;
+	int ret;
+
+	np = of_get_child_by_name(dev->of_node, "non-pixel");
+	if (!np)
+		return;
+
+	mem = of_parse_phandle(np, "memory-region", 0);
+	rmem = mem ? of_reserved_mem_lookup(mem) : NULL;
+	of_node_put(mem);
+	if (!rmem || of_property_read_u32(np, "qcom,iommu-vmid", &s->vmid)) {
+		dev_err(dev, "non-pixel: needs memory-region and qcom,iommu-vmid\n");
+		goto put_node;
+	}
+
+	info.fwnode = &np->fwnode;
+	info.parent = dev;
+	info.name = np->name;
+	info.dma_mask = DMA_BIT_MASK(32);
+	pdev = platform_device_register_full(&info);
+	if (IS_ERR(pdev))
+		goto put_node;
+	pdev->dev.of_node = np;
+
+	ret = of_dma_configure(&pdev->dev, np, true);
+	if (ret)
+		goto err_unregister;
+
+	domain = iommu_paging_domain_alloc(&pdev->dev);
+	if (IS_ERR(domain)) {
+		ret = PTR_ERR(domain);
+		goto err_unregister;
+	}
+	ret = iommu_attach_device(domain, &pdev->dev);
+	if (ret)
+		goto err_domain_free;
+
+	s->phys = rmem->base;
+	s->size = rmem->size;
+	s->iova = VENUS_SECNP_IOVA;
+	ret = venus_secnp_assign(core, true);
+	if (ret)
+		goto err_detach;
+
+	ret = iommu_map(domain, s->iova, s->phys, s->size,
+			IOMMU_READ | IOMMU_WRITE, GFP_KERNEL);
+	if (ret)
+		goto err_unassign;
+
+	s->pool = gen_pool_create(PAGE_SHIFT, -1);
+	if (!s->pool) {
+		ret = -ENOMEM;
+		goto err_unmap;
+	}
+	ret = gen_pool_add(s->pool, s->iova, s->size, -1);
+	if (ret)
+		goto err_pool;
+
+	s->dev = &pdev->dev;
+	s->iommu_domain = domain;
+	of_node_put(np);
+	dev_info(dev, "non-pixel bank: %zu KiB for VM %u\n", s->size / SZ_1K, s->vmid);
+	return;
+
+err_pool:
+	gen_pool_destroy(s->pool);
+	s->pool = NULL;
+err_unmap:
+	iommu_unmap(domain, s->iova, s->size);
+err_unassign:
+	if (venus_secnp_assign(core, false))
+		dev_err(dev, "non-pixel: carveout stays with VM %u\n", s->vmid);
+err_detach:
+	iommu_detach_device(domain, &pdev->dev);
+err_domain_free:
+	iommu_domain_free(domain);
+err_unregister:
+	platform_device_unregister(pdev);
+	dev_err(dev, "non-pixel bank failed: %d\n", ret);
+put_node:
+	of_node_put(np);
+}
+
+void venus_secnp_deinit(struct venus_core *core)
+{
+	struct venus_secnp *s = &core->secnp;
+
+	if (!s->dev)
+		return;
+
+	/* all sessions are gone: every buffer is back in the pool */
+	gen_pool_destroy(s->pool);
+	s->pool = NULL;
+	iommu_unmap(s->iommu_domain, s->iova, s->size);
+	if (venus_secnp_assign(core, false))
+		dev_err(core->dev, "non-pixel: carveout stays with VM %u\n", s->vmid);
+	iommu_detach_device(s->iommu_domain, s->dev);
+	iommu_domain_free(s->iommu_domain);
+	platform_device_unregister(to_platform_device(s->dev));
+	s->dev = NULL;
+}
+
 void venus_firmware_deinit(struct venus_core *core)
 {
 	struct iommu_domain *iommu;
