From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pixel5 <pixel5@localhost>
Date: Sat, 21 Nov 2026 09:40:00 +0000
Subject: [PATCH] WIP: ASoC: rt5514: load the RT5514P DSP over SPI

NOT IN THE SERIES: bring-up state, with debug output and module
parameters (rt5514 spi_switch=, rt5514-spi mode= hz=).

On the Google Pixel 5 (RT5514P, VENDOR_ID1 0x80) the I2S stream comes
from the RT5514 DSP; the plain ADC path gives digital silence. Google's
downstream rt5514.c loads rt5514p_dsp_fw1..4.bin over SPI, starts the
DSP and selects DSP_FUNC WOV_I2S_SENSOR for each recording. This adds:

- "DSP I2S Capture Switch": one-way, loads and starts the DSP
  (register values, firmware names and addresses from downstream);
- hw_params/hw_free switch DSP_FUNC to/from WOV_I2S_SENSOR;
- RT5514P DSP registers in the I2C readable list (regmap_update_bits on
  0x18002074 silently failed without it);
- rt5514-spi: burst_write returns spi_write errors and zero-pads a short
  last 8-byte group (it read past the buffer); burst_read returns
  0/-errno (it returned true/false) and keeps its command off the stack
  (GPI DMA).

Status (Tests 166-167): SPI transfers complete (GPI DMA), but every SPI
read returns zeros, including the ID register (I2C: 10ec5514), in SPI
modes 0-3, at 1 and 10 MHz, with RT5514 GPIO5 (the AP/CHRE SPI switch)
untouched, low or high. The firmware readback therefore fails and the
DSP is not started. See docs/log.md.
---
diff --git a/sound/soc/codecs/rt5514-spi.c b/sound/soc/codecs/rt5514-spi.c
index bcc2ff28b..e1c6e61c3 100644
--- a/sound/soc/codecs/rt5514-spi.c
+++ b/sound/soc/codecs/rt5514-spi.c
@@ -332,16 +332,53 @@ static const struct snd_soc_component_driver rt5514_spi_component = {
  *
  * Returns true for success.
  */
+/* bring-up: override the DT SPI mode (-1 = keep) and speed (0 = keep) */
+static int spi_mode_override = -1;
+module_param_named(mode, spi_mode_override, int, 0644);
+static int spi_hz_override;
+module_param_named(hz, spi_hz_override, int, 0644);
+
+static void rt5514_spi_apply_overrides(void)
+{
+	bool change = false;
+
+	if (spi_mode_override >= 0 &&
+	    (rt5514_spi->mode & SPI_MODE_X_MASK) != spi_mode_override) {
+		rt5514_spi->mode = (rt5514_spi->mode & ~SPI_MODE_X_MASK) |
+				   spi_mode_override;
+		change = true;
+	}
+	if (spi_hz_override > 0 && rt5514_spi->max_speed_hz != spi_hz_override) {
+		rt5514_spi->max_speed_hz = spi_hz_override;
+		change = true;
+	}
+	if (change) {
+		spi_setup(rt5514_spi);
+		dev_info(&rt5514_spi->dev, "mode %u, %u Hz\n",
+			 rt5514_spi->mode & SPI_MODE_X_MASK,
+			 rt5514_spi->max_speed_hz);
+	}
+}
+
 int rt5514_spi_burst_read(unsigned int addr, u8 *rxbuf, size_t len)
 {
 	u8 spi_cmd = RT5514_SPI_CMD_BURST_READ;
-	int status;
-	u8 write_buf[8];
+	int status = 0;
+	u8 *write_buf;
 	unsigned int i, end, offset = 0;
 
 	struct spi_message message;
 	struct spi_transfer x[3];
 
+	if (!rt5514_spi)
+		return -ENODEV;
+	rt5514_spi_apply_overrides();
+
+	/* not on the stack: the controller may DMA from it */
+	write_buf = kmalloc(8, GFP_KERNEL);
+	if (!write_buf)
+		return -ENOMEM;
+
 	while (offset < len) {
 		if (offset + RT5514_SPI_BUF_LEN <= len)
 			end = RT5514_SPI_BUF_LEN;
@@ -372,7 +409,7 @@ int rt5514_spi_burst_read(unsigned int addr, u8 *rxbuf, size_t len)
 		status = spi_sync(rt5514_spi, &message);
 
 		if (status)
-			return false;
+			goto out;
 
 		offset += RT5514_SPI_BUF_LEN;
 	}
@@ -397,7 +434,9 @@ int rt5514_spi_burst_read(unsigned int addr, u8 *rxbuf, size_t len)
 		rxbuf[i + 7] = write_buf[0];
 	}
 
-	return true;
+out:
+	kfree(write_buf);
+	return status;
 }
 EXPORT_SYMBOL_GPL(rt5514_spi_burst_read);
 
@@ -414,9 +453,13 @@ int rt5514_spi_burst_write(u32 addr, const u8 *txbuf, size_t len)
 {
 	u8 spi_cmd = RT5514_SPI_CMD_BURST_WRITE;
 	u8 *write_buf;
-	unsigned int i, end, offset = 0;
+	unsigned int i, j, end, offset = 0;
+	int ret = 0;
+
+	if (!rt5514_spi)
+		return -ENODEV;
 
-	write_buf = kmalloc(RT5514_SPI_BUF_LEN + 6, GFP_KERNEL);
+	write_buf = kzalloc(RT5514_SPI_BUF_LEN + 6, GFP_KERNEL);
 
 	if (write_buf == NULL)
 		return -ENOMEM;
@@ -433,27 +476,25 @@ int rt5514_spi_burst_write(u32 addr, const u8 *txbuf, size_t len)
 		write_buf[3] = ((addr + offset) & 0x0000ff00) >> 8;
 		write_buf[4] = ((addr + offset) & 0x000000ff) >> 0;
 
-		for (i = 0; i < end; i += 8) {
-			write_buf[i + 12] = txbuf[offset + i + 0];
-			write_buf[i + 11] = txbuf[offset + i + 1];
-			write_buf[i + 10] = txbuf[offset + i + 2];
-			write_buf[i +  9] = txbuf[offset + i + 3];
-			write_buf[i +  8] = txbuf[offset + i + 4];
-			write_buf[i +  7] = txbuf[offset + i + 5];
-			write_buf[i +  6] = txbuf[offset + i + 6];
-			write_buf[i +  5] = txbuf[offset + i + 7];
-		}
+		/* 8-byte groups, byte-reversed; zero-pad a short last one */
+		for (i = 0; i < end; i += 8)
+			for (j = 0; j < 8; j++)
+				write_buf[i + 12 - j] = offset + i + j < len ?
+							txbuf[offset + i + j] : 0;
 
+		end = ALIGN(end, 8);
 		write_buf[end + 5] = spi_cmd;
 
-		spi_write(rt5514_spi, write_buf, end + 6);
+		ret = spi_write(rt5514_spi, write_buf, end + 6);
+		if (ret)
+			break;
 
 		offset += RT5514_SPI_BUF_LEN;
 	}
 
 	kfree(write_buf);
 
-	return 0;
+	return ret;
 }
 EXPORT_SYMBOL_GPL(rt5514_spi_burst_write);
 
diff --git a/sound/soc/codecs/rt5514.c b/sound/soc/codecs/rt5514.c
index a33fbc9fb..059742b79 100644
--- a/sound/soc/codecs/rt5514.c
+++ b/sound/soc/codecs/rt5514.c
@@ -263,6 +263,11 @@ static bool rt5514_i2c_readable_register(struct device *dev,
 	case RT5514_DSP_MAPPING | RT5514_DSP_CTRL4:
 	case RT5514_DSP_MAPPING | RT5514_VENDOR_ID1:
 	case RT5514_DSP_MAPPING | RT5514_VENDOR_ID2:
+	/* RT5514P DSP: run/filter-reset flag, GPIO5 (SPI switch), DSP mode */
+	case 0x18001014:
+	case 0x18002074:
+	case 0x18002fac:
+	case 0x18002fb0:
 		return true;
 
 	default:
@@ -283,6 +288,222 @@ static const DECLARE_TLV_DB_RANGE(bst_tlv,
 
 static const DECLARE_TLV_DB_SCALE(adc_vol_tlv, -1725, 75, 0);
 
+/*
+ * Google Pixel 5 (RT5514P): its I2S/TDM stream comes from the RT5514 DSP,
+ * not from the plain ADC path (Google's downstream rt5514.c forces the DSP
+ * on for every recording). Register values, firmware names and load
+ * addresses below are from that driver.
+ */
+#define RT5514_DSP_WOV_TYPE		0x18002fac
+#define RT5514_DSP_FUNC			0x18002fb0
+#define RT5514_DSP_CHRE_INFORM		0x18002fec
+#define RT5514_DSP_WOV_BOTH		0
+#define RT5514_DSP_FUNC_WOV_SENSOR	1
+#define RT5514_DSP_FUNC_WOV_I2S_SENSOR	3
+
+static const struct reg_sequence rt5514p_i2c_patch[] = {
+	{0xfafafafa, 0x00000001},
+	{0x18002000, 0x000010ec},
+	{0x18002004, 0x00808f81},
+	{0x18002008, 0x00770000},
+	{0x18002f08, 0x00000006},
+	{0x18002f10, 0x00000000},
+	{0x18002f10, 0x00000001},
+	{0xfafafafa, 0x00000000},
+	{0x18001104, 0x00000007},
+	{0x18001108, 0x00000000},
+	{0x1800110c, 0x00000000},
+	{0x18001100, 0x0000031f},
+	{0x18002000, 0x000010ec},
+};
+
+/* rt5514_enable_dsp_prepare(), RT5514P branch */
+static const struct reg_sequence rt5514p_dsp_prepare[] = {
+	{0x18002004, 0x00808f81},
+	{0x18002008, 0x00770000},
+	{0x18002200, 0x00028704},	/* LDO current limit */
+	{0x18002070, 0x00000040},	/* pin config */
+	{0x18002240, 0x0000001e},	/* PLL3 = 1.3 MHz x 31 = 40 MHz */
+	{0x18002100, 0x0000000b},	/* PLL3 source RCOSC */
+	{0x18002f08, 0x00000005},	/* DSP clock from PLL3, on */
+	{0x18001118, 0x00000001},	/* reduce DSP power */
+	{0x18002fcc, 0x00000001},	/* DSP buffer: mono */
+	{0x18002124, 0x00220012},	/* DFLL reset */
+	{0x18002110, 0x000104c4},	/* DFLL m/n */
+	{0x18002124, 0x80220012},
+	{0x18002124, 0xc0220012},
+};
+
+static const char * const rt5514p_fw_name[4] = {
+	"rt5514p_dsp_fw1.bin", "rt5514p_dsp_fw2.bin",
+	"rt5514p_dsp_fw3.bin", "rt5514p_dsp_fw4.bin",
+};
+
+static void rt5514p_dsp_filter_reset(struct rt5514_priv *rt5514)
+{
+	/* resets the DSP filter and its buffer pointers */
+	regmap_write(rt5514->i2c_regmap, 0x18001014, 1);
+	regmap_write(rt5514->i2c_regmap, RT5514_DSP_CHRE_INFORM, 0);
+}
+
+/* bring-up: 0 = leave GPIO5 alone, 1 = drive low, 2 = drive high */
+static int rt5514_spi_switch = 1;
+module_param_named(spi_switch, rt5514_spi_switch, int, 0644);
+
+static void rt5514p_spi_probe(struct rt5514_priv *rt5514, const char *when)
+{
+#if IS_ENABLED(CONFIG_SND_SOC_RT5514_SPI)
+	/* bring-up probe: the same registers over I2C and over SPI */
+	static const u32 probe_reg[] = { 0x18002ff0, 0x18002ff4, 0x18002074 };
+	struct device *dev = rt5514->component->dev;
+	u8 *b = kzalloc(8, GFP_KERNEL);
+	unsigned int v = 0;
+	int k, r;
+
+	for (k = 0; b && k < ARRAY_SIZE(probe_reg); k++) {
+		regmap_read(rt5514->i2c_regmap, probe_reg[k], &v);
+		r = rt5514_spi_burst_read(probe_reg[k], b, 8);
+		dev_info(dev, "%s 0x%08x: i2c %08x spi(%d) %8ph\n",
+			 when, probe_reg[k], v, r, b);
+	}
+	kfree(b);
+#endif
+}
+
+static int rt5514p_dsp_load(struct rt5514_priv *rt5514)
+{
+	struct device *dev = rt5514->component->dev;
+	u32 addr[4] = { 0x4fe00000, 0x4ff00000, 0x4fe98000, 0x4fea8000 };
+	u32 model[2] = { 0, 0 };
+	const struct firmware *fw;
+	unsigned int val = 1;
+	int i, ret;
+
+	rt5514p_spi_probe(rt5514, "before patch");
+	regmap_multi_reg_write(rt5514->i2c_regmap, rt5514p_i2c_patch,
+			       ARRAY_SIZE(rt5514p_i2c_patch));
+	regmap_multi_reg_write(rt5514->i2c_regmap, rt5514p_dsp_prepare,
+			       ARRAY_SIZE(rt5514p_dsp_prepare));
+	regmap_write(rt5514->i2c_regmap, RT5514_DSP_WOV_TYPE,
+		     RT5514_DSP_WOV_BOTH);
+	/*
+	 * RT5514 GPIO5 drives the switch that gives its SPI slave port to
+	 * the AP (low) or to the ADSP's CHRE (high). Keep it on the AP;
+	 * the AP's handshake GPIO (TLMM 66) is held high by pinctrl.
+	 */
+	if (rt5514_spi_switch) {
+		regmap_update_bits(rt5514->i2c_regmap, 0x18002070, BIT(8), BIT(8));
+		regmap_update_bits(rt5514->i2c_regmap, 0x18002074,
+				   BIT(21) | BIT(22),
+				   BIT(22) | (rt5514_spi_switch == 2 ? BIT(21) : 0));
+	}
+
+	rt5514p_spi_probe(rt5514, "after patch");
+
+	for (i = 0; i < 4; i++) {
+		ret = request_firmware(&fw, rt5514p_fw_name[i], dev);
+		if (ret)
+			return ret;
+
+		/* fw1 starts with the sound model address (if not default) */
+		if (i == 0 && fw->size >= sizeof(model)) {
+			memcpy(model, fw->data, sizeof(model));
+			if (model[0])
+				addr[2] = model[0];
+		}
+#if IS_ENABLED(CONFIG_SND_SOC_RT5514_SPI)
+		ret = rt5514_spi_burst_write(addr[i], fw->data, fw->size);
+#else
+		ret = -ENODEV;
+#endif
+#if IS_ENABLED(CONFIG_SND_SOC_RT5514_SPI)
+		if (!ret) {
+			/* read it back (before fw1's model pointer is patched) */
+			size_t n = ALIGN(fw->size, 8);
+			u8 *buf = kzalloc(n, GFP_KERNEL);
+
+			ret = buf ? rt5514_spi_burst_read(addr[i], buf, n) : -ENOMEM;
+			if (!ret && memcmp(buf, fw->data, fw->size)) {
+				size_t k = 0, bad = 0, o;
+
+				for (o = 0; o < fw->size; o++)
+					if (buf[o] != fw->data[o] && !bad++)
+						k = o;
+				k &= ~15;
+				dev_info(dev, "DSP: %zu bytes differ, first at %zu\n",
+					 bad, k);
+				print_hex_dump(KERN_INFO, "want ", DUMP_PREFIX_OFFSET,
+					       16, 1, fw->data + k, 16, false);
+				print_hex_dump(KERN_INFO, "got  ", DUMP_PREFIX_OFFSET,
+					       16, 1, buf + k, 16, false);
+				ret = -EIO;
+			}
+			kfree(buf);
+		}
+#endif
+		dev_info(dev, "DSP: %s (%zu bytes) -> 0x%08x, read back: %d\n",
+			 rt5514p_fw_name[i], fw->size, addr[i], ret);
+		if (!ret && i == 2 && model[0]) {
+			addr[3] = addr[2] + ((fw->size / 8) + 1) * 8;
+#if IS_ENABLED(CONFIG_SND_SOC_RT5514_SPI)
+			ret = rt5514_spi_burst_write(addr[0], (u8 *)&addr[2], 8);
+#endif
+		}
+		release_firmware(fw);
+		if (ret)
+			return ret;
+	}
+
+	regmap_write(rt5514->i2c_regmap, 0x18002f08, 0x0000000b); /* 40 MHz */
+	regmap_write(rt5514->i2c_regmap, 0x18002f00, 0x00055148); /* run */
+	usleep_range(10000, 10005);
+	regmap_write(rt5514->i2c_regmap, RT5514_DSP_FUNC,
+		     RT5514_DSP_FUNC_WOV_SENSOR);
+	rt5514p_dsp_filter_reset(rt5514);
+
+	/* the DSP clears the filter reset request when it runs */
+	for (i = 0; i < 10; i++) {
+		regmap_read(rt5514->i2c_regmap, 0x18001014, &val);
+		if (!val)
+			break;
+		usleep_range(10000, 15000);
+	}
+	dev_info(dev, "DSP %s (0x18001014 = %u)\n",
+		 val ? "not running" : "running", val);
+
+	return val ? -EIO : 0;
+}
+
+static int rt5514_dsp_i2s_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct rt5514_priv *rt5514 = snd_soc_component_get_drvdata(component);
+
+	ucontrol->value.integer.value[0] = rt5514->dsp_i2s;
+	return 0;
+}
+
+static int rt5514_dsp_i2s_put(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct rt5514_priv *rt5514 = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	/* one way: load and start once, while no stream runs */
+	if (!ucontrol->value.integer.value[0] || rt5514->dsp_i2s)
+		return 0;
+	if (snd_soc_component_active(component))
+		return -EBUSY;
+
+	ret = rt5514p_dsp_load(rt5514);
+	if (ret)
+		return ret;
+	rt5514->dsp_i2s = true;
+	return 1;
+}
+
 static int rt5514_dsp_voice_wake_up_get(struct snd_kcontrol *kcontrol,
 		struct snd_ctl_elem_value *ucontrol)
 {
@@ -433,6 +654,8 @@ static const struct snd_kcontrol_new rt5514_snd_controls[] = {
 		adc_vol_tlv),
 	SOC_SINGLE_EXT("DSP Voice Wake Up", SND_SOC_NOPM, 0, 1, 0,
 		rt5514_dsp_voice_wake_up_get, rt5514_dsp_voice_wake_up_put),
+	SOC_SINGLE_BOOL_EXT("DSP I2S Capture Switch", 0,
+		rt5514_dsp_i2s_get, rt5514_dsp_i2s_put),
 };
 
 /* ADC Mixer*/
@@ -756,6 +979,16 @@ static int rt5514_hw_params(struct snd_pcm_substream *substream,
 	int pre_div, bclk_ms, frame_size;
 	unsigned int val_len = 0;
 
+	if (rt5514->dsp_i2s) {
+		/* the DSP streams to I2S; downstream sets nothing else */
+		regmap_write(rt5514->i2c_regmap, RT5514_DSP_FUNC,
+			     RT5514_DSP_FUNC_WOV_I2S_SENSOR);
+		rt5514p_dsp_filter_reset(rt5514);
+		regmap_update_bits(rt5514->i2c_regmap, 0x18002010, 0x3,
+				   params_width(params) == 24 ? 0x2 : 0x0);
+		return 0;
+	}
+
 	rt5514->lrck = params_rate(params);
 	pre_div = rl6231_get_clk_info(rt5514->sysclk, rt5514->lrck);
 	if (pre_div < 0) {
@@ -1140,8 +1373,23 @@ static const u64 rt5514_selectable_formats =
 	SND_SOC_POSSIBLE_DAIFMT_IB_NF	|
 	SND_SOC_POSSIBLE_DAIFMT_IB_IF;
 
+static int rt5514_hw_free(struct snd_pcm_substream *substream,
+			  struct snd_soc_dai *dai)
+{
+	struct rt5514_priv *rt5514 =
+		snd_soc_component_get_drvdata(dai->component);
+
+	if (rt5514->dsp_i2s) {
+		regmap_write(rt5514->i2c_regmap, RT5514_DSP_FUNC,
+			     RT5514_DSP_FUNC_WOV_SENSOR);
+		rt5514p_dsp_filter_reset(rt5514);
+	}
+	return 0;
+}
+
 static const struct snd_soc_dai_ops rt5514_aif_dai_ops = {
 	.hw_params = rt5514_hw_params,
+	.hw_free = rt5514_hw_free,
 	.set_fmt = rt5514_set_dai_fmt,
 	.set_sysclk = rt5514_set_dai_sysclk,
 	.set_pll = rt5514_set_dai_pll,
diff --git a/sound/soc/codecs/rt5514.h b/sound/soc/codecs/rt5514.h
index 75755599f..26ff128a3 100644
--- a/sound/soc/codecs/rt5514.h
+++ b/sound/soc/codecs/rt5514.h
@@ -281,6 +281,7 @@ struct rt5514_priv {
 	int pll_out;
 	int dsp_enabled;
 	unsigned int pll3_cal_value;
+	bool dsp_i2s;		/* RT5514P DSP produces the I2S stream */
 };
 
 #endif /* __RT5514_H__ */
