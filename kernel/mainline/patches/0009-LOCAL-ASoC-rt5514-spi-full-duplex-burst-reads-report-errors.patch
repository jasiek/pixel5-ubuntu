From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pixel5 <pixel5@localhost>
Date: Sat, 21 Nov 2026 12:00:00 +0000
Subject: [PATCH 1/2] LOCAL: ASoC: rt5514-spi: full-duplex burst reads, report
 errors

On the Google Pixel 5 the RT5514P sits on a GENI SPI controller that
only works through GPI DMA (its FIFO interface is disabled by firmware).
There, a receive-only transfer returns zeros, while full-duplex and
transmit-only transfers work. The burst read used a receive-only third
transfer, so every read, even of the ID register, gave zeros.

Read each chunk with one full-duplex transfer (command, address, four
dummy bytes, then the data) from heap buffers, which the controller may
DMA from and to. Also:

- burst_read returned true/false; return 0 or a negative errno;
- burst_write ignored spi_write() errors, and for a length that is not a
  multiple of 8 it read past the end of the source buffer: zero-pad the
  last 8-byte group and return the first error;
- both return -ENODEV before the SPI device has probed.

No caller checked burst_read's return value before.
---
diff --git a/sound/soc/codecs/rt5514-spi.c b/sound/soc/codecs/rt5514-spi.c
index bcc2ff28b..2e002a334 100644
--- a/sound/soc/codecs/rt5514-spi.c
+++ b/sound/soc/codecs/rt5514-spi.c
@@ -335,12 +335,28 @@ static const struct snd_soc_component_driver rt5514_spi_component = {
 int rt5514_spi_burst_read(unsigned int addr, u8 *rxbuf, size_t len)
 {
 	u8 spi_cmd = RT5514_SPI_CMD_BURST_READ;
-	int status;
-	u8 write_buf[8];
+	int status = 0;
+	u8 *tx, *rx, t;
 	unsigned int i, end, offset = 0;
 
 	struct spi_message message;
-	struct spi_transfer x[3];
+	struct spi_transfer x;
+
+	if (!rt5514_spi)
+		return -ENODEV;
+
+	/*
+	 * One full-duplex transfer per chunk: command + address (5 bytes),
+	 * 4 dummy bytes, then the data. A separate receive-only transfer
+	 * returns zeros on the GENI SPI GPI DMA path (Pixel 5, Test 169).
+	 * Not on the stack: the controller DMAs from/to them.
+	 */
+	tx = kzalloc(RT5514_SPI_BUF_LEN + 9, GFP_KERNEL);
+	rx = kzalloc(RT5514_SPI_BUF_LEN + 9, GFP_KERNEL);
+	if (!tx || !rx) {
+		status = -ENOMEM;
+		goto out;
+	}
 
 	while (offset < len) {
 		if (offset + RT5514_SPI_BUF_LEN <= len)
@@ -348,56 +364,39 @@ int rt5514_spi_burst_read(unsigned int addr, u8 *rxbuf, size_t len)
 		else
 			end = len % RT5514_SPI_BUF_LEN;
 
-		write_buf[0] = spi_cmd;
-		write_buf[1] = ((addr + offset) & 0xff000000) >> 24;
-		write_buf[2] = ((addr + offset) & 0x00ff0000) >> 16;
-		write_buf[3] = ((addr + offset) & 0x0000ff00) >> 8;
-		write_buf[4] = ((addr + offset) & 0x000000ff) >> 0;
+		tx[0] = spi_cmd;
+		tx[1] = ((addr + offset) & 0xff000000) >> 24;
+		tx[2] = ((addr + offset) & 0x00ff0000) >> 16;
+		tx[3] = ((addr + offset) & 0x0000ff00) >> 8;
+		tx[4] = ((addr + offset) & 0x000000ff) >> 0;
 
 		spi_message_init(&message);
-		memset(x, 0, sizeof(x));
-
-		x[0].len = 5;
-		x[0].tx_buf = write_buf;
-		spi_message_add_tail(&x[0], &message);
-
-		x[1].len = 4;
-		x[1].tx_buf = write_buf;
-		spi_message_add_tail(&x[1], &message);
-
-		x[2].len = end;
-		x[2].rx_buf = rxbuf + offset;
-		spi_message_add_tail(&x[2], &message);
+		memset(&x, 0, sizeof(x));
+		x.len = 9 + end;
+		x.tx_buf = tx;
+		x.rx_buf = rx;
+		spi_message_add_tail(&x, &message);
 
 		status = spi_sync(rt5514_spi, &message);
-
 		if (status)
-			return false;
+			goto out;
 
+		memcpy(rxbuf + offset, rx + 9, end);
 		offset += RT5514_SPI_BUF_LEN;
 	}
 
-	for (i = 0; i < len; i += 8) {
-		write_buf[0] = rxbuf[i + 0];
-		write_buf[1] = rxbuf[i + 1];
-		write_buf[2] = rxbuf[i + 2];
-		write_buf[3] = rxbuf[i + 3];
-		write_buf[4] = rxbuf[i + 4];
-		write_buf[5] = rxbuf[i + 5];
-		write_buf[6] = rxbuf[i + 6];
-		write_buf[7] = rxbuf[i + 7];
-
-		rxbuf[i + 0] = write_buf[7];
-		rxbuf[i + 1] = write_buf[6];
-		rxbuf[i + 2] = write_buf[5];
-		rxbuf[i + 3] = write_buf[4];
-		rxbuf[i + 4] = write_buf[3];
-		rxbuf[i + 5] = write_buf[2];
-		rxbuf[i + 6] = write_buf[1];
-		rxbuf[i + 7] = write_buf[0];
+	/* the device sends 8-byte groups most significant byte first */
+	for (i = 0; i + 8 <= len; i += 8) {
+		t = rxbuf[i + 0]; rxbuf[i + 0] = rxbuf[i + 7]; rxbuf[i + 7] = t;
+		t = rxbuf[i + 1]; rxbuf[i + 1] = rxbuf[i + 6]; rxbuf[i + 6] = t;
+		t = rxbuf[i + 2]; rxbuf[i + 2] = rxbuf[i + 5]; rxbuf[i + 5] = t;
+		t = rxbuf[i + 3]; rxbuf[i + 3] = rxbuf[i + 4]; rxbuf[i + 4] = t;
 	}
 
-	return true;
+out:
+	kfree(tx);
+	kfree(rx);
+	return status;
 }
 EXPORT_SYMBOL_GPL(rt5514_spi_burst_read);
 
@@ -414,9 +413,13 @@ int rt5514_spi_burst_write(u32 addr, const u8 *txbuf, size_t len)
 {
 	u8 spi_cmd = RT5514_SPI_CMD_BURST_WRITE;
 	u8 *write_buf;
-	unsigned int i, end, offset = 0;
+	unsigned int i, j, end, offset = 0;
+	int ret = 0;
+
+	if (!rt5514_spi)
+		return -ENODEV;
 
-	write_buf = kmalloc(RT5514_SPI_BUF_LEN + 6, GFP_KERNEL);
+	write_buf = kzalloc(RT5514_SPI_BUF_LEN + 6, GFP_KERNEL);
 
 	if (write_buf == NULL)
 		return -ENOMEM;
@@ -433,27 +436,25 @@ int rt5514_spi_burst_write(u32 addr, const u8 *txbuf, size_t len)
 		write_buf[3] = ((addr + offset) & 0x0000ff00) >> 8;
 		write_buf[4] = ((addr + offset) & 0x000000ff) >> 0;
 
-		for (i = 0; i < end; i += 8) {
-			write_buf[i + 12] = txbuf[offset + i + 0];
-			write_buf[i + 11] = txbuf[offset + i + 1];
-			write_buf[i + 10] = txbuf[offset + i + 2];
-			write_buf[i +  9] = txbuf[offset + i + 3];
-			write_buf[i +  8] = txbuf[offset + i + 4];
-			write_buf[i +  7] = txbuf[offset + i + 5];
-			write_buf[i +  6] = txbuf[offset + i + 6];
-			write_buf[i +  5] = txbuf[offset + i + 7];
-		}
+		/* 8-byte groups, byte-reversed; zero-pad a short last one */
+		for (i = 0; i < end; i += 8)
+			for (j = 0; j < 8; j++)
+				write_buf[i + 12 - j] = offset + i + j < len ?
+							txbuf[offset + i + j] : 0;
 
+		end = ALIGN(end, 8);
 		write_buf[end + 5] = spi_cmd;
 
-		spi_write(rt5514_spi, write_buf, end + 6);
+		ret = spi_write(rt5514_spi, write_buf, end + 6);
+		if (ret)
+			break;
 
 		offset += RT5514_SPI_BUF_LEN;
 	}
 
 	kfree(write_buf);
 
-	return 0;
+	return ret;
 }
 EXPORT_SYMBOL_GPL(rt5514_spi_burst_write);
 
