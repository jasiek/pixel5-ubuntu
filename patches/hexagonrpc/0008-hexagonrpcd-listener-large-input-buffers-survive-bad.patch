From 87ac5011e8c528937f47ca6a9b3155f7340d0f10 Mon Sep 17 00:00:00 2001
From: Jan Szumiec <noreply@localhost>
Date: Fri, 20 Nov 2026 15:53:05 +0100
Subject: [PATCH 8/8] hexagonrpcd: listener: large input buffers, survive bad
 requests

SPDX-License-Identifier: GPL-3.0-or-later
The encoded input buffers of a request were limited to 256 bytes, and
anything larger ended the listener ('Large (>256B) input buffers aren't
implemented'). The redfin sensor PD writes its registry with fwrite
calls of several KiB, so the daemon exited and the PD crashed.

Do what qualcomm/fastrpc src/listener_android.c does: when
adsp_listener_next2 reports more bytes than fit in the buffer, fetch the
rest with adsp_listener_get_in_bufs2 (method 5 of adsp_listener: context
and offset in, buffer and required length out). The first buffer is now
4096 bytes. Output buffers had no such limit: they are sized from the
request and returned in one piece.

The listener also ended on any request it could not serve: an unknown
handle or method, a wrong buffer count or size, or a request that did
not decode. Return the error to the remote processor and carry on; only
a failure of the transport ends the loop now. As in Qualcomm's listener,
no output buffers are returned with an error.
---
 hexagonrpcd/interfaces/adsp_listener.def |   1 +
 hexagonrpcd/listener.c                   | 144 +++++++++++++++++++----
 2 files changed, 122 insertions(+), 23 deletions(-)

diff --git a/hexagonrpcd/interfaces/adsp_listener.def b/hexagonrpcd/interfaces/adsp_listener.def
index 4f521c0..1620471 100644
--- a/hexagonrpcd/interfaces/adsp_listener.def
+++ b/hexagonrpcd/interfaces/adsp_listener.def
@@ -28,5 +28,6 @@
 
 HEXAGONRPC_DEFINE_REMOTE_METHOD(3, adsp_listener_init2, 0, 0, 0, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(4, adsp_listener_next2, 2, 1, 4, 1)
+HEXAGONRPC_DEFINE_REMOTE_METHOD(5, adsp_listener_get_in_bufs2, 2, 0, 1, 1)
 
 #endif /* INTERFACE_ADSP_LISTENER_DEF */
diff --git a/hexagonrpcd/listener.c b/hexagonrpcd/listener.c
index e1994c2..0ed1d6b 100644
--- a/hexagonrpcd/listener.c
+++ b/hexagonrpcd/listener.c
@@ -30,6 +30,13 @@
 #include "iobuffer.h"
 #include "listener.h"
 
+/*
+ * This is the size of the buffer given to adsp_listener_next2. The input
+ * buffers of most requests fit; the rest is fetched with
+ * adsp_listener_get_in_bufs2.
+ */
+#define INBUFS_SIZE 4096
+
 static int adsp_listener_init2(int fd)
 {
 	return fastrpc2(&adsp_listener_init2_def, fd, ADSP_LISTENER_HANDLE);
@@ -56,6 +63,19 @@ static int adsp_listener_next2(int fd,
 			inbufs_size, inbufs);
 }
 
+static int adsp_listener_get_in_bufs2(int fd,
+				      uint32_t rctx,
+				      uint32_t offset,
+				      uint32_t *inbufs_len,
+				      uint32_t inbufs_size, void *inbufs)
+{
+	return fastrpc2(&adsp_listener_get_in_bufs2_def, fd, ADSP_LISTENER_HANDLE,
+			rctx,
+			offset,
+			inbufs_len,
+			inbufs_size, inbufs);
+}
+
 static struct fastrpc_io_buffer *allocate_outbufs(const struct fastrpc_function_def_interp2 *def,
 						  uint32_t *first_inbuf)
 {
@@ -133,6 +153,54 @@ static int check_inbuf_sizes(const struct fastrpc_function_def_interp2 *def,
 	return 0;
 }
 
+/*
+ * Fetch the rest of the input buffers of a request that did not fit in the
+ * buffer given to adsp_listener_next2. The remote processor keeps the encoded
+ * input buffers and hands out the part after the given offset.
+ */
+static int fetch_large_inbufs(int fd, uint32_t rctx,
+			      uint32_t received, uint32_t total,
+			      char **inbufs)
+{
+	char *tmp;
+	uint32_t required;
+	int ret;
+
+	tmp = realloc(*inbufs, total);
+	if (tmp == NULL) {
+		perror("Could not allocate encoded input buffer");
+		return -1;
+	}
+
+	*inbufs = tmp;
+
+	ret = adsp_listener_get_in_bufs2(fd, rctx, received, &required,
+					 total - received, &tmp[received]);
+	if (ret) {
+		if (ret == -1)
+			perror("Could not fetch large input buffers");
+		else
+			fprintf(stderr, "Could not fetch large input buffers: %d\n", ret);
+
+		return -1;
+	}
+
+	if (required > total) {
+		fprintf(stderr, "Input buffers grew from %" PRIu32 " to %" PRIu32 " bytes\n",
+				total, required);
+		return -1;
+	}
+
+	return 0;
+}
+
+/*
+ * Return the result of the previous request and wait for the next one.
+ *
+ * A negative return value means that the transport failed. A positive one is
+ * an error for a request that was received but could not be decoded: there
+ * are no decoded buffers, and the error should be returned for it.
+ */
 static int return_for_next_invoke(int fd,
 				  uint32_t result,
 				  uint32_t *rctx,
@@ -142,19 +210,30 @@ static int return_for_next_invoke(int fd,
 				  struct fastrpc_io_buffer **decoded)
 {
 	struct fastrpc_decoder_context *ctx;
-	char inbufs[256];
+	char *inbufs;
 	char *outbufs = NULL;
 	uint32_t inbufs_len;
-	uint32_t outbufs_len;
+	uint32_t outbufs_len = 0;
 	int ret;
 
-	outbufs_len = outbufs_calculate_size(REMOTE_SCALARS_OUTBUFS(*sc), returned);
+	*decoded = NULL;
+
+	inbufs = malloc(INBUFS_SIZE);
+	if (inbufs == NULL) {
+		perror("Could not allocate encoded input buffer");
+		return -1;
+	}
+
+	// The output buffers of a failed request are not returned
+	if (!result && returned != NULL)
+		outbufs_len = outbufs_calculate_size(REMOTE_SCALARS_OUTBUFS(*sc), returned);
 
 	if (outbufs_len) {
 		outbufs = malloc(outbufs_len);
 		if (outbufs == NULL) {
 			perror("Could not allocate encoded output buffer");
-			return -1;
+			ret = -1;
+			goto err_free_inbufs;
 		}
 
 		outbufs_encode(REMOTE_SCALARS_OUTBUFS(*sc), returned, outbufs);
@@ -164,45 +243,53 @@ static int return_for_next_invoke(int fd,
 				  *rctx, result,
 				  outbufs_len, outbufs,
 				  rctx, handle, sc,
-				  &inbufs_len, 256, inbufs);
+				  &inbufs_len, INBUFS_SIZE, inbufs);
 	if (ret) {
 		if (ret == -1)
 			perror("Could not fetch next FastRPC message");
 		else
 			fprintf(stderr, "Could not fetch next FastRPC message: %d\n", ret);
 
+		ret = -1;
 		goto err_free_outbufs;
 	}
 
-	if (inbufs_len > 256) {
-		fprintf(stderr, "Large (>256B) input buffers aren't implemented\n");
-		ret = -1;
-		goto err_free_outbufs;
+	if (inbufs_len > INBUFS_SIZE) {
+		ret = fetch_large_inbufs(fd, *rctx, INBUFS_SIZE, inbufs_len,
+					 &inbufs);
+		if (ret) {
+			ret = AEE_EFAILED;
+			goto err_free_outbufs;
+		}
 	}
 
 	ctx = inbuf_decode_start(*sc);
 	if (!ctx) {
 		perror("Could not start decoding");
-		ret = -1;
+		ret = AEE_ENOMEMORY;
 		goto err_free_outbufs;
 	}
 
 	ret = inbuf_decode(ctx, inbufs_len, inbufs);
 	if (ret) {
 		perror("Could not decode");
-		goto err_free_outbufs;
-	}
-
-	if (!inbuf_decode_is_complete(ctx)) {
+		ret = AEE_ENOMEMORY;
+	} else if (!inbuf_decode_is_complete(ctx)) {
 		fprintf(stderr, "Expected more input buffers\n");
-		ret = -1;
-		goto err_free_outbufs;
+		ret = AEE_EBADPARM;
 	}
 
 	*decoded = inbuf_decode_finish(ctx);
 
+	if (ret) {
+		iobuf_free(REMOTE_SCALARS_INBUFS(*sc), *decoded);
+		*decoded = NULL;
+	}
+
 err_free_outbufs:
 	free(outbufs);
+err_free_inbufs:
+	free(inbufs);
 	return ret;
 }
 
@@ -307,26 +394,37 @@ int run_fastrpc_listener(int fd,
 		return ret;
 	}
 
-	while (!ret) {
+	/*
+	 * Only a failure of the transport ends the loop. A request that is
+	 * malformed or not supported gets an error and the listener carries on.
+	 */
+	while (1) {
 		ret = return_for_next_invoke(fd,
 					     result, &rctx, &handle, &sc,
 					     returned, &decoded);
-		if (ret)
-			break;
 
 		if (returned != NULL)
 			iobuf_free(n_outbufs, returned);
 
+		returned = NULL;
+		n_outbufs = 0;
+
+		if (ret < 0)
+			break;
+
+		if (ret > 0) {
+			result = ret;
+			continue;
+		}
+
 		ret = invoke_requested_procedure(n_ifaces, ifaces,
 						 handle, sc, &result,
 						 decoded, &returned);
-		if (ret)
-			break;
+		if (!ret)
+			n_outbufs = REMOTE_SCALARS_OUTBUFS(sc);
 
 		if (decoded != NULL)
 			iobuf_free(REMOTE_SCALARS_INBUFS(sc), decoded);
-
-		n_outbufs = REMOTE_SCALARS_OUTBUFS(sc);
 	}
 
 	return ret;
-- 
