From 7b3b1fb9b01ff84d3314db79e1a6d45b84b2503b Mon Sep 17 00:00:00 2001
From: Jan Szumiec <noreply@localhost>
Date: Fri, 20 Nov 2026 15:53:05 +0100
Subject: [PATCH 7/8] hexagonrpcd: iobuffer: decode empty input buffers

SPDX-License-Identifier: GPL-3.0-or-later
An input buffer of length 0 is only its length word (pack_in_bufs() in
qualcomm/fastrpc inc/listener_buf.h). The decoder never moved on to the
next buffer after one, so the request ended in 'Expected more input
buffers'. An fwrite of 0 bytes is such a request.

Also zero the buffer list, so that a partly decoded request can be
freed.
---
 hexagonrpcd/iobuffer.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/hexagonrpcd/iobuffer.c b/hexagonrpcd/iobuffer.c
index d80b953..6257475 100644
--- a/hexagonrpcd/iobuffer.c
+++ b/hexagonrpcd/iobuffer.c
@@ -55,12 +55,16 @@ static int try_populate_inbuf(struct fastrpc_decoder_context *ctx)
 		return 0;
 
 	buf = malloc(ctx->size);
-	if (buf == NULL)
+	if (buf == NULL && ctx->size)
 		return -1;
 
 	ctx->inbufs[ctx->idx].s = ctx->size;
 	ctx->inbufs[ctx->idx].p = buf;
 
+	// An empty buffer has no contents to wait for
+	if (ctx->size == 0)
+		ctx->idx++;
+
 	return 0;
 }
 
@@ -143,7 +147,7 @@ struct fastrpc_decoder_context *inbuf_decode_start(uint32_t sc)
 	ctx->buf_off = 0;
 	ctx->align = 0;
 
-	ctx->inbufs = malloc(sizeof(*ctx->inbufs) * ctx->n_inbufs);
+	ctx->inbufs = calloc(ctx->n_inbufs, sizeof(*ctx->inbufs));
 	if (ctx->inbufs == NULL && ctx->n_inbufs != 0)
 		goto err;
 
