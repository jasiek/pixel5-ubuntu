From 801bf5162f879095035e075a08bc08e077d482dc Mon Sep 17 00:00:00 2001
From: Jan Szumiec <noreply@localhost>
Date: Fri, 20 Nov 2026 15:46:26 +0100
Subject: [PATCH 6/6] hexagonrpcd: apps_std: write support in writable
 directories

SPDX-License-Identifier: GPL-3.0-or-later
Let the remote processor modify files in a writable directory (only
persist/sensors/registry, if it is mapped writable):

- fopen_with_env (19) honours the modes w, w+, a, a+ and r+
- fwrite (5), fsync (23), fremove (24), ftrunc (32), frename (33)

The method numbers follow the order of qualcomm/fastrpc idl/apps_std.idl
and the argument layouts its src/apps_std_skel.c. Failures in a writable
directory return the errno, as Qualcomm's daemon does.

Outside of a writable directory nothing changes: opening for writing
logs the attempt and returns AEE_EUNSUPPORTED, as do the new methods,
and r+ opens read-only. Names are resolved from the virtual root.

Every write-side operation is logged in one line on stderr:
  write-open <path> <mode> -> <file>
  write <file> <bytes>
  truncate <file> <length>
  rename <old> -> <new>
  remove <path>
---
 hexagonrpcd/apps_std.c              | 224 ++++++++++++++++++++++++++--
 hexagonrpcd/interfaces/apps_std.def |  10 ++
 2 files changed, 225 insertions(+), 9 deletions(-)

diff --git a/hexagonrpcd/apps_std.c b/hexagonrpcd/apps_std.c
index 640b20a..fa2f354 100644
--- a/hexagonrpcd/apps_std.c
+++ b/hexagonrpcd/apps_std.c
@@ -20,6 +20,8 @@
  */
 
 #include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
 #include <stdio.h>
 #include <stdint.h>
 #include <string.h>
@@ -45,6 +47,31 @@ static const int apps_std_whence_table[] = {
 	SEEK_END,
 };
 
+static bool is_string(const struct fastrpc_io_buffer *buf)
+{
+	return buf->s > 0 && ((const char *) buf->p)[buf->s - 1] == 0;
+}
+
+/*
+ * Translate an fopen() mode. O_RDONLY is returned for anything that does not
+ * ask for write access.
+ */
+static int apps_std_open_flags(const char *mode)
+{
+	bool update = strchr(mode, '+') != NULL;
+
+	switch (mode[0]) {
+	case 'r':
+		return update ? O_RDWR : O_RDONLY;
+	case 'w':
+		return (update ? O_RDWR : O_WRONLY) | O_CREAT | O_TRUNC;
+	case 'a':
+		return (update ? O_RDWR : O_WRONLY) | O_CREAT | O_APPEND;
+	default:
+		return O_RDONLY;
+	}
+}
+
 /*
  * This is a placeholder function used to complete any I/O operations.
  * File descriptors do not have a flush operation because their reads and
@@ -118,6 +145,147 @@ static uint32_t apps_std_fread(void *data,
 	return 0;
 }
 
+/*
+ * Writing is only possible to files opened for writing in a writable
+ * directory. Every write-side operation is logged.
+ */
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct {
+		uint32_t fd;
+		uint32_t buf_size;
+	} *first_in = inbufs[0].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+	ssize_t ret;
+
+	ret = hexagonfs_write(ctx->fds, first_in->fd,
+			      inbufs[1].s, inbufs[1].p);
+	if (ret == -EROFS) {
+		fprintf(stderr, "Tried to write to read-only file %u\n",
+				first_in->fd);
+		return AEE_EUNSUPPORTED;
+	} else if (ret < 0) {
+		fprintf(stderr, "write %u %u: %s\n", first_in->fd,
+				first_in->buf_size, strerror(-ret));
+		return -ret;
+	}
+
+	fprintf(stderr, "write %u %zd\n", first_in->fd, ret);
+
+	first_out->written = ret;
+	first_out->is_eof = 0;
+
+	return 0;
+}
+
+static uint32_t apps_std_fsync(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const uint32_t *fd = inbufs[0].p;
+	int ret;
+
+	ret = hexagonfs_fsync(ctx->fds, *fd);
+	if (ret) {
+		fprintf(stderr, "sync %u: %s\n", *fd, strerror(-ret));
+		return -ret;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("fsync(%u)\n", *fd);
+#endif
+
+	return 0;
+}
+
+static uint32_t apps_std_fremove(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *name = inbufs[1].p;
+	int ret;
+
+	if (!is_string(&inbufs[1]))
+		return AEE_EBADPARM;
+
+	ret = hexagonfs_unlink(ctx->fds, ctx->rootfd, ctx->rootfd, name);
+	if (ret == -EROFS) {
+		fprintf(stderr, "Tried to remove %s\n", name);
+		return AEE_EUNSUPPORTED;
+	} else if (ret) {
+		fprintf(stderr, "remove %s: %s\n", name, strerror(-ret));
+		return -ret;
+	}
+
+	fprintf(stderr, "remove %s\n", name);
+
+	return 0;
+}
+
+static uint32_t apps_std_ftrunc(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct {
+		uint32_t method;
+		uint32_t fd;
+		int32_t len;
+	} *first_in = inbufs[0].p;
+	int ret;
+
+	ret = hexagonfs_ftruncate(ctx->fds, first_in->fd, first_in->len);
+	if (ret == -EROFS) {
+		fprintf(stderr, "Tried to truncate read-only file %u\n",
+				first_in->fd);
+		return AEE_EUNSUPPORTED;
+	} else if (ret) {
+		fprintf(stderr, "truncate %u %d: %s\n", first_in->fd,
+				first_in->len, strerror(-ret));
+		return -ret;
+	}
+
+	fprintf(stderr, "truncate %u %d\n", first_in->fd, first_in->len);
+
+	return 0;
+}
+
+static uint32_t apps_std_frename(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *oldname = inbufs[1].p;
+	const char *newname = inbufs[2].p;
+	int ret;
+
+	if (!is_string(&inbufs[1]) || !is_string(&inbufs[2]))
+		return AEE_EBADPARM;
+
+	ret = hexagonfs_rename(ctx->fds, ctx->rootfd, ctx->rootfd,
+			       oldname, newname);
+	if (ret == -EROFS) {
+		fprintf(stderr, "Tried to rename %s -> %s\n", oldname, newname);
+		return AEE_EUNSUPPORTED;
+	} else if (ret) {
+		fprintf(stderr, "rename %s -> %s: %s\n", oldname, newname,
+				strerror(-ret));
+		return -ret;
+	}
+
+	fprintf(stderr, "rename %s -> %s\n", oldname, newname);
+
+	return 0;
+}
+
 static uint32_t apps_std_fseek(void *data,
 			       const struct fastrpc_io_buffer *inbufs,
 			       struct fastrpc_io_buffer *outbufs)
@@ -154,8 +322,10 @@ static uint32_t apps_std_fopen_with_env(void *data,
 {
 	struct apps_std_ctx *ctx = data;
 	uint32_t *out = outbufs[0].p;
+	const char *name = inbufs[3].p;
+	const char *mode = inbufs[4].p;
 	char rw_mode;
-	int dirfd, fd;
+	int dirfd, fd, flags;
 
 	// The name and environment variable must also be NULL-terminated
 	if (((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0
@@ -164,10 +334,29 @@ static uint32_t apps_std_fopen_with_env(void *data,
 		return AEE_EBADPARM;
 
 	rw_mode = ((const char *) inbufs[4].p)[0];
-	if (rw_mode == 'w' || rw_mode == 'a') {
-		fprintf(stderr, "Tried to open %s for writing\n",
-				(const char *) inbufs[3].p);
-		return AEE_EUNSUPPORTED;
+
+	/*
+	 * Files in a writable directory are opened as asked. Anywhere else,
+	 * "w" and "a" are refused and "r+" falls back to read-only below.
+	 */
+	flags = apps_std_open_flags(mode);
+	if (flags != O_RDONLY) {
+		fd = hexagonfs_open_write(ctx->fds, ctx->rootfd, ctx->rootfd,
+					  name, flags);
+		if (fd >= 0) {
+			fprintf(stderr, "write-open %s %s -> %d\n",
+					name, mode, fd);
+			*out = fd;
+			return 0;
+		} else if (fd != -EROFS) {
+			fprintf(stderr, "write-open %s %s: %s\n",
+					name, mode, strerror(-fd));
+			return -fd;
+		} else if (rw_mode != 'r') {
+			fprintf(stderr, "Tried to open %s for writing\n",
+					name);
+			return AEE_EUNSUPPORTED;
+		}
 	}
 
 	if (!strcmp(inbufs[1].p, "ADSP_LIBRARY_PATH")) {
@@ -418,7 +607,10 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_fread_def,
 		.impl = apps_std_fread,
 	},
-	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fwrite_def,
+		.impl = apps_std_fwrite,
+	},
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
@@ -442,8 +634,14 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
-	{ .def = NULL, .impl = NULL, },
-	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fsync_def,
+		.impl = apps_std_fsync,
+	},
+	{
+		.def = &apps_std_fremove_def,
+		.impl = apps_std_fremove,
+	},
 	{ .def = NULL, .impl = NULL, },
 	{
 		.def = &apps_std_opendir_def,
@@ -463,10 +661,18 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_stat_def,
 		.impl = apps_std_stat,
 	},
+	{
+		.def = &apps_std_ftrunc_def,
+		.impl = apps_std_ftrunc,
+	},
+	{
+		.def = &apps_std_frename_def,
+		.impl = apps_std_frename,
+	},
 };
 
 const struct fastrpc_interface apps_std_interface = {
 	.name = "apps_std",
-	.n_procs = 32,
+	.n_procs = 34,
 	.procs = apps_std_procs,
 };
diff --git a/hexagonrpcd/interfaces/apps_std.def b/hexagonrpcd/interfaces/apps_std.def
index 8f2a9cb..39f3c27 100644
--- a/hexagonrpcd/interfaces/apps_std.def
+++ b/hexagonrpcd/interfaces/apps_std.def
@@ -28,11 +28,21 @@ HEXAGONRPC_DEFINE_REMOTE_METHOD(1, apps_std_freopen, 1, 0, 1, 1)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(2, apps_std_fflush, 1, 0, 0, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(3, apps_std_fclose, 1, 0, 0, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(4, apps_std_fread, 1, 0, 2, 1)
+HEXAGONRPC_DEFINE_REMOTE_METHOD(5, apps_std_fwrite, 1, 1, 2, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(9, apps_std_fseek, 3, 0, 0, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(19, apps_std_fopen_with_env, 0, 4, 1, 0)
+HEXAGONRPC_DEFINE_REMOTE_METHOD(23, apps_std_fsync, 1, 0, 0, 0)
+HEXAGONRPC_DEFINE_REMOTE_METHOD(24, apps_std_fremove, 0, 1, 0, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(26, apps_std_opendir, 0, 1, 2, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(27, apps_std_closedir, 2, 0, 0, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(28, apps_std_readdir, 2, 0, 66, 0)
+
+/*
+ * Methods 31 and above are all sent as method 31, with the real method number
+ * as the first input number.
+ */
 HEXAGONRPC_DEFINE_REMOTE_METHOD(31, apps_std_stat, 1, 1, 24, 0)
+HEXAGONRPC_DEFINE_REMOTE_METHOD(32, apps_std_ftrunc, 3, 0, 0, 0)
+HEXAGONRPC_DEFINE_REMOTE_METHOD(33, apps_std_frename, 1, 2, 0, 0)
 
 #endif /* INTERFACE_APPS_STD_DEF */
-- 
