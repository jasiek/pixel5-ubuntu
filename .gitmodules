[submodule "external/mkbootimg"]
	path = external/mkbootimg
	url = https://android.googlesource.com/platform/system/tools/mkbootimg
	shallow = true
[submodule "external/avb"]
	path = external/avb
	url = https://android.googlesource.com/platform/external/avb
	shallow = true
[submodule "external/qbootctl"]
	path = external/qbootctl
	url = https://github.com/linux-msm/qbootctl
[submodule "external/pil-squasher"]
	path = external/pil-squasher
	url = https://github.com/linux-msm/pil-squasher
	shallow = true
[submodule "external/parse-android-dynparts"]
	path = external/parse-android-dynparts
	url = https://github.com/tchebb/parse-android-dynparts
[submodule "external/lpunpack"]
	path = external/lpunpack
	url = https://github.com/unix3dgforce/lpunpack
	shallow = true
[submodule "external/kernel-redbull"]
	path = external/kernel-redbull
	url = https://github.com/LineageOS/android_kernel_google_redbull
	branch = lineage-24.0
	shallow = true
	ignore = dirty
[submodule "external/pd-mapper"]
	path = external/pd-mapper
	url = https://github.com/linux-msm/pd-mapper
[submodule "external/tqftpserv"]
	path = external/tqftpserv
	url = https://github.com/linux-msm/tqftpserv
[submodule "external/nairo"]
	path = external/nairo
	url = https://github.com/effeffe/nairoArchLinuxArmTools
	shallow = true
[submodule "external/linux-next"]
	path = external/linux-next
	url = https://git.kernel.org/pub/scm/linux/kernel/git/next/linux-next.git
	shallow = true
[submodule "external/hexagonrpc"]
	path = external/hexagonrpc
	url = https://github.com/linux-msm/hexagonrpc
[submodule "external/fastrpc"]
	path = external/fastrpc
	url = https://github.com/qualcomm/fastrpc
[submodule "external/lmdpdg"]
	path = external/lmdpdg
	url = https://github.com/msm8916-mainline/linux-mdss-dsi-panel-driver-generator
